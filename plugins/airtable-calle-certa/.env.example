# Airtable. Personal Access Token with schema.bases:read plus record read/write
# on the base below. Create at https://airtable.com/create/tokens
AIRTABLE_TOKEN=pat_example_replace_me
AIRTABLE_BASE_ID=appExampleReplaceMe

# CALL-E. From https://dashboard.heycall-e.com/account/api-keys
# Only needed for `certa run`. `preview` and `replay` do not use it.
CALLE_API_KEY=iams_live_example_replace_me

# The organisation disclosed on every call. A verification call from an
# unnamed party is pretexting, so this is required and is spoken aloud.
CERTA_REQUESTER_NAME=Example Lending
