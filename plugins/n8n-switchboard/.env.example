# Auth path A: CALL-E Developer API (beta onboarding required)
CALLE_API_KEY=
CALLE_BASE_URL=

# Auth path B: local calle CLI over MCP (no key needed, uses cached login)
CALLE_USE_CLI=true

# Console
SWITCHBOARD_PORT=4300

# Safety defaults
SWITCHBOARD_QUIET_START=21:00
SWITCHBOARD_QUIET_END=08:00
SWITCHBOARD_MAX_CALLS_PER_RECIPIENT_PER_DAY=2
