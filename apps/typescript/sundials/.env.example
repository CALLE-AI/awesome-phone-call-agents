# Telephony Provider (optional). Leave these blank for dry-run.
# A leftover API key is not enough; CALLE_LIVE must also be true for a real call.
CALLE_API_KEY=
CALLE_AGENT_ID=sundial_default
CALLE_LIVE=false

# Official CALL-E API origin (do not use api.call-e.ai)
CALLE_BASE_URL=https://api.heycall-e.com

# Local SQLite file (created on first npm run dev). Not required to set.
SUNDIALS_DB_PATH=./data/sundials.db

# Seeded Harbor dashboard login (default username harbor / password harbor).
# SUNDIALS_HARBOR_PASSWORD=harbor
# SUNDIALS_SESSION_SECRET=

# Optional: Gemini Flash (gemini-3.6-flash) for post-call sales briefings,
# Brain Copilot, and richer drafts from ingested sites/files. Server-side only.
# Never exposed to the browser or the public SDK key.
# Without a key, Brain still drafts from /demo or uploaded text.
GEMINI_API_KEY=

# Public base URL for local testing
NEXT_PUBLIC_APP_URL=http://localhost:3000
