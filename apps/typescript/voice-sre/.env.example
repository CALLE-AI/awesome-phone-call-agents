# CALL-E API Configuration
CALLE_API_KEY=your_calle_api_key_here

# Target On-Call Phone Number (Must be strict E.164 format, e.g., +12025550123 or +84912345678)
ONCALL_PHONE_NUMBER=+12025550123

# Execution Mode: 'preview' (default, safe dry-run) or 'live' (places actual call)
VOICE_SRE_MODE=preview

# Server Port
PORT=3000
