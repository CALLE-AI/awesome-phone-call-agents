# Express Server
PORT=3001
NODE_ENV=development

# Provider Mode ('mock' or 'calle')
PHONE_PROVIDER_MODE=mock

# CALL-E API Credentials (used if PHONE_PROVIDER_MODE=calle)
CALL_E_API_KEY=
CALL_E_WEBHOOK_SECRET=

# LLM API Credentials (used for request parsing in live mode)
LLM_API_KEY=

# Supabase/PostgreSQL Credentials (intended for production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
