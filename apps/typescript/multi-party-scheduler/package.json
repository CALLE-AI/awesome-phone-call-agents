{
  "name": "calle-multi-party-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-phase booking over phone calls: gather availability, confirm one time with everyone, release everyone if the commit fails.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx demo/run-local.ts",
    "schedule": "tsx src/cli.ts",
    "plan": "tsx src/cli.ts plan --request examples/request.example.json"
  },
  "dependencies": {
    "@call-e/calle": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
