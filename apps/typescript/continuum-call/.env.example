# Local only - never commit real values.
# API key: https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# One explicitly consented, allowlisted E.164 test number.
CALLE_TEST_PHONE=
CALLE_REGION=DE
CALLE_LOCALE=de-DE

# Safe defaults. Tests and the local demo stay mock-only.
SPIKE_LIVE=0
SPIKE_STOP=1

# Named one-call verification gate. Every value must be changed deliberately
# before invoking `npx tsx scripts/spike/live-runtime-verify.ts live`.
CALLE_LIVE_EXPERIMENT=
CALLE_LIVE_CONFIRMATION=
CALLE_LIVE_ALLOWLIST=
CALLE_LIVE_CONSENT=0
CALLE_LIVE_MAX_CALLS=0
CALLE_LIVE_BUDGET_REMAINING=0
CALLE_LIVE_TIMEZONE=Europe/Berlin
CALLE_LIVE_WINDOW_START=
CALLE_LIVE_WINDOW_END=
# Optional explicit locations. Both locks are persistent and never removed by
# the live adapter; inspect them before deciding whether to run another test.
CALLE_LIVE_RESERVATION_FILE=
CONTINUUM_LIVE_DB=.data/runtime-live-verify.sqlite
CONTINUUM_GLOBAL_STOP_FILE=.data/global-stop.lock

# Ops Console mutating routes (development-only default if unset).
OPS_TOKEN=dev-mock
