    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@call-e/calle": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}