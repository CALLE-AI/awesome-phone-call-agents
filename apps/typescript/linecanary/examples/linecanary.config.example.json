  "checks": [
    {
      "id": "reception-hours",
      "line": "main-office",
      "task": "You are placing a routine test call. Ask whoever or whatever answers: 'What are your opening hours on Saturday?' Record the answer verbatim. Do not press any keys and do not ask anything else.",
      "resultSchema": {
        "type": "object",
        "properties": {
          "answered": {
            "type": "boolean",
            "description": "True when the line was answered by a person or agent."
          },
          "hours_answer": {
            "type": "string",
            "description": "The verbatim answer about Saturday hours."
          }
        },
        "required": [
          "answered"
        ],
        "additionalProperties": false
      },
      "assert": [
        {
          "path": "answered",
          "equals": true
        },
        {
          "path": "hours_answer",
          "matches": "saturday|weekend"
        }
      ],
      "timing": {
        "maxSecondsToAnswer": 20
      },
      "minConfidence": 0.6,
      "name": "Reception hours"
    },
    {
      "id": "ivr-billing-path",
      "line": "client-clinic",
      "task": "You are placing a routine IVR test call. Listen to the menu. Report which option number is announced for billing questions, and the full list of options you heard. Do not press any keys.",
      "resultSchema": {
        "type": "object",
        "properties": {
          "billing_option": {
            "type": "string",
            "description": "The option number announced for billing, e.g. '3'."
          },
          "menu_options": {
            "type": "string",
            "description": "The announced options in order."
          }
        },
        "required": [
          "billing_option"
        ],
        "additionalProperties": false
      },
      "assert": [
        {
          "path": "billing_option",
          "equals": "3"
        },
        {
          "path": "menu_options",
          "contains": "appointments"
        }
      ],
      "timing": {
        "maxSecondsToAnswer": 10
      },
      "name": "Billing menu option"
    }
  ],
