# AfterHold API — environment configuration.
# Copy to .env and fill in real values. .env is git-ignored.

# ── Server ───────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8081
DATABASE_FILE=./data/afterhold.db

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-32-bytes-of-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── CALL-E runtime ───────────────────────────────────────────────────
# Default: real CALL-E calls. Set CALLE_MOCK=1 to run the scripted phase
# timeline without burning free-tier calls (useful for the demo video or
# offline dev).
CALLE_MOCK=0
CALLE_ENABLED=1
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# ── Worker cadence ───────────────────────────────────────────────────
POLL_FIRST_DELAY_SEC=60
POLL_INTERVAL_SEC=8

# ── Safety ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=5
QUIET_HOURS_START=21
QUIET_HOURS_END=7

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
