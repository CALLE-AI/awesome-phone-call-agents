# AfterHold API — environment configuration.
# Copy to .env and fill in real values. .env is git-ignored.
#
# Defaults are safe: mock mode (no real calls), loopback-only server.

# ── Server ───────────────────────────────────────────────────────────
PORT=8787
# Loopback only. Change to 0.0.0.0 only behind TLS, with a real JWT_SECRET.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8081
DATABASE_FILE=./data/afterhold.db

# ── Auth ─────────────────────────────────────────────────────────────
# Leave empty for a local mock run (an ephemeral secret is generated).
# REQUIRED for live mode or any non-loopback HOST: `openssl rand -hex 32`.
# Public example values are rejected at startup.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── CALL-E runtime ───────────────────────────────────────────────────
# Default: mock mode. The scripted phase timeline runs and no call is placed.
# Live mode needs CALLE_MOCK=0, CALLE_API_KEY, an allowlisted destination,
# a recipient region, and `confirm_live: true` on every /start request.
CALLE_MOCK=1
CALLE_ENABLED=1
CALLE_API_KEY=
# Only https://api.heycall-e.com or https://test-api.heycall-e.com are accepted.
CALLE_BASE_URL=https://api.heycall-e.com

# ── Worker cadence ───────────────────────────────────────────────────
POLL_FIRST_DELAY_SEC=60
POLL_INTERVAL_SEC=8

# ── Safety ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=5
QUIET_HOURS_START=21
QUIET_HOURS_END=7

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
