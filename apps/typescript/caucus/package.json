{
  "name": "caucus",
  "version": "0.1.0",
  "description": "Neutral AI mediation for two-party disputes over real phone calls \u2014 shuttle diplomacy as a protocol, built on CALL-E",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "rehearse": "tsx scripts/run-live-case.ts --rehearse --yes",
    "demo": "tsx scripts/build-demo.ts demo.db",
    "dashboard": "tsx scripts/serve-dashboard.ts"
  },
  "dependencies": {
    "@call-e/calle": "^0.2.2",
    "better-sqlite3": "^12.4.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "fast-check": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.23.5"
  }
}