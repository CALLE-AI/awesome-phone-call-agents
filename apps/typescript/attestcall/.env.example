# AttestCall configuration
# Demo mode is ON by default. Nothing calls out unless you set DEMO_MODE=false.

# Set to false to place REAL CALL-E phone calls. Requires CALLE_API_KEY.
DEMO_MODE=true

# Your CALL-E API key (only needed when DEMO_MODE=false).
# Get one at https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# Optional: override the CALL-E API base URL.
# CALLE_BASE_URL=https://api.heycall-e.com

# Where the hash-chained audit log is written (JSON lines).
ATTEST_AUDIT_FILE=./data/attestations.log

# Dashboard HTTP port.
PORT=4600
