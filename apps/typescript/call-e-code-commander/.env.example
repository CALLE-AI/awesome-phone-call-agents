# CALL-E Code Commander — server configuration
#
# Copy this file to .env and fill it in. .env is gitignored; this file is not,
# so never put a real key or a real phone number here.

# Production keys start with iams_live_. Read on the server only: the dev server
# attaches it to outbound requests and it never reaches browser code.
# Get one from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=iams_live_replace_me

# Optional. Seeds the on-call rota so a demo does not start with empty fields.
# Numbers must be E.164, and their destination must be in CALL-E's published
# coverage. Leave any rung blank to skip it.
CALLE_ROTA_PRIMARY_NAME=
CALLE_ROTA_PRIMARY_PHONE=
CALLE_ROTA_BACKUP_NAME=
CALLE_ROTA_BACKUP_PHONE=
CALLE_ROTA_MANAGER_NAME=
CALLE_ROTA_MANAGER_PHONE=

# --- Hosted deployment only -------------------------------------------------

# Destinations a public deployment is allowed to ring, comma separated, E.164.
# The rota numbers above are always allowed, so this is for anything extra, such
# as a reviewer's own phone. A deployed copy with no allowed destination at all
# refuses every call rather than becoming an anonymous dialler on your balance.
# A local dev server ignores this and dials whatever you type.
CALLE_DEMO_ALLOWED_NUMBERS=

# Where CALL-E should post terminal call state, so an escalation survives the
# browser tab that started it. Absolute HTTPS. On Vercel this is
# https://your-deployment.vercel.app/api/calle/webhook. Locally it needs a
# tunnel, and with nothing set the app polls instead, which is fine while
# somebody is watching the page.
CALLE_WEBHOOK_URL=

# Optional shared secret appended to that URL as ?token=... It keeps
# unsolicited traffic out of the receiver. It is not authentication, and nothing
# is trusted because of it: CALL-E does not sign webhooks, so every delivery is
# verified by re-reading the call from the API before anything is recorded.
CALLE_WEBHOOK_TOKEN=

# Where terminal call outcomes are written. Defaults to .calle/incidents.json
# under the dev server, which is gitignored because it holds transcripts of
# calls to real people. Unset on a serverless host, outcomes live in memory and
# are lost when the instance recycles.
CALLE_INCIDENT_STORE_PATH=
