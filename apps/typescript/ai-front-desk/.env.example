# CALL-E credentials — get yours from the CALL-E dashboard.
# NEVER commit a real key.
CALLE_API_KEY=calle_live_replace_me

# CALL-E API base URL. Point at the local fake server for no-call testing.
CALLE_BASE_URL=https://api.heycall-e.com

# Safety valve: when true (the default), NO real phone calls are placed.
# The app logs the constructed task + schema and records a deterministic
# mock result instead. Flip to false only for deliberate live verification.
CALLE_DRY_RUN=true

# Where the demo/dev phone calls go in live mode. Must be YOUR OWN verified
# number in E.164 format. Every recipient number in the seed data is fictional
# (+1555...); live calls are only ever routed to this override number.
LIVE_CALL_OVERRIDE_PHONE=

# SQLite database file (Prisma)
DATABASE_URL="file:./dev.db"

# Server
PORT=3000

# Required. Bearer token that every /api request must present
# (Authorization: Bearer <key>). Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Cron expression for the daily confirmation sweep (default: 9am daily).
# Set CONFIRM_CRON_ENABLED=false to disable the scheduler entirely.
CONFIRM_CRON="0 9 * * *"
CONFIRM_CRON_ENABLED=true
