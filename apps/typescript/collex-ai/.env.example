# Copy this file to .env and fill in your own values.
# Nothing here is required to run the demo it works fully in dry-run mode
# with the sample-leads.json fixture and zero external credentials.

# CALL-E
CALLE_API_KEY=your_calle_api_key_here
CALLE_DRY_RUN=true          # set to "false" only if you want to place a real call

# LLM (used by buildTask.js to draft the call task text)
GROQ_API_KEY=your_groq_api_key_here   # optional — only needed to exercise the live LLM step
LLM_DRY_RUN=true            # when true, buildTask.js returns a canned task instead of calling Groq