# Server-only CALL-E credentials. Copy this file to .env.local.
CALLE_API_KEY=

# Optional link used when opening the authoritative CALL-E billing screen.
# CALL-E's current public API does not expose an account-balance endpoint.
CALLE_BILLING_DASHBOARD_URL=https://dashboard.heycall-e.com/account/billing

# Keep false during development. Change to true only for a controlled live test.
CALLE_LIVE_CALLS_ENABLED=false

# Optional ClickUp connector. Users enter their personal token inside the private
# application; this key encrypts it before D1 storage. Use at least 24 random
# characters and store the real value as a server secret.
INTEGRATION_ENCRYPTION_KEY=

# Keep true for one private company deployment. A future public multi-tenant
# release should set this false and require authenticated user identity.
SINGLE_TENANT_MODE=true
