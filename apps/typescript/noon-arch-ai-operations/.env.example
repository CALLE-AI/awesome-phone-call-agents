# Server-only CALL-E credentials. Copy this file to .env.local.
CALLE_API_KEY=

# Optional link used when opening the authoritative CALL-E billing screen.
# CALL-E's current public API does not expose an account-balance endpoint.
CALLE_BILLING_DASHBOARD_URL=https://dashboard.heycall-e.com/account/billing

# Keep false during development. Change to true only for a controlled live test.
CALLE_LIVE_CALLS_ENABLED=false

# CALL-E bearer credentials are sent only to the default official API origin.
# Additional operator-approved HTTPS provider origins may be configured here;
# CALLE_API_BASE_URL must be exactly one of them. Redirects are always refused.
CALLE_API_BASE_URL=https://api.heycall-e.com
CALLE_APPROVED_API_ORIGINS=

# Optional ClickUp connector. Users enter their personal token inside the private
# application; this key encrypts it before D1 storage. Use at least 24 random
# characters and store the real value as a server secret.
INTEGRATION_ENCRYPTION_KEY=

# Required for real operator API routes. An authenticated trusted ingress must
# strip client-supplied identity/secret headers and inject both its verified
# oai-authenticated-user-id (and email) and this secret. Never expose the backend
# directly or send this value to the browser. Use >=32 random characters.
AI_OPS_TRUSTED_INGRESS_SECRET=
AI_OPS_OWNER_USER_ID=
