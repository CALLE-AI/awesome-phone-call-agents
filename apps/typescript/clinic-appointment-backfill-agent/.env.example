# Database Configuration
DATABASE_URL="file:./dev.db"

# CALL-E Configuration
# Must use HTTPS for production; plain HTTP will be rejected
# Must not contain credential prefixes in logs
CALLE_BASE_URL="https://api.heycall-e.com"

# CALL-E API Key (required for live calls)
# ⚠️ SECURITY: Do not log this value; only credential prefix logged for audit
# Get this from CALL-E dashboard (https://dashboard.heycall-e.com)
CALLE_API_KEY="iams_live_YOUR_API_KEY_HERE"

# Server Configuration
PORT=3000

# Live Call Gate (SECURITY REQUIREMENT)
# Must be EXPLICITLY set to 'true' to enable actual outbound calls to real phone numbers
# When false, all calls use mock/demo mode (useful for testing)
# ⚠️ CRITICAL: Requires BOTH ALLOW_LIVE_CALLS=true AND valid CALLE_API_KEY to place real calls
ALLOW_LIVE_CALLS=false

# Demo Mode (optional, for local development)
# When set to 'true', authentication is optional on all endpoints
# ⚠️ SECURITY: Never enable in production
DEMO_MODE=true