# Database Configuration
DATABASE_URL="file:./dev.db"

# Server Configuration
PORT=3000

# Operator API authentication
# Every /api/* request must include: Authorization: Bearer <API_AUTH_TOKEN>
# If omitted, any non-empty Bearer token is accepted for local reference demos.
API_AUTH_TOKEN="change-me-for-local-demo"

# CALL-E Configuration
# Must use HTTPS. The API key is read only from environment/secret configuration,
# never from request bodies.
CALLE_BASE_URL="https://api.heycall-e.com"
CALLE_API_KEY="iams_live_YOUR_API_KEY_HERE"
CALLE_API_KEY_SOURCE="env"

# Live Call Gate
# Real outbound calls require all of the following:
# 1. ALLOW_LIVE_CALLS=true
# 2. CALLE_API_KEY set from CALLE_API_KEY_SOURCE=env, secret-manager, or vault
# 3. Each exact E.164 destination listed in ALLOWED_LIVE_RECIPIENTS for this run
ALLOW_LIVE_CALLS=false
ALLOWED_LIVE_RECIPIENTS="+15555550100,+15555550101"

# Demo data can be reset through the authenticated dashboard/API.
# There is no unauthenticated DEMO_MODE bypass for patient or call-control routes.
