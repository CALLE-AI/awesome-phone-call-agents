{
  "name": "@dial/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "calle:verify": "tsx src/scripts/calle-verify.ts"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/helmet": "^12.0.1",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.45.2",
    "@dial/config": "*",
    "@dial/schemas": "*",
    "@dial/domain": "*",
    "@dial/database": "*",
    "@dial/search": "*",
    "@dial/ai": "*",
    "@dial/calle": "*",
    "@dial/orchestrator": "*",
    "@dial/observability": "*"
  },
  "devDependencies": { "tsx": "^4.19.1", "vitest": "^2.1.2", "@types/node": "^22.7.5" }
}
