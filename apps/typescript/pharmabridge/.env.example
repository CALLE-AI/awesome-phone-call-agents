# Copy to .env.local. Server-side only; never expose to the browser.
CALLE_API_KEY=
# The key is only ever sent to CALL-E's official HTTPS API. A loopback test server (http://127.0.0.1:…)
# is allowed only with CALLE_LOCAL_TEST_TRANSPORT=true and CALLE_API_KEY=local-test-only.
# Never use a real key with a local test server. Redirects are always refused.
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_LOCAL_TEST_TRANSPORT=false

# Live dialing is OFF unless this is exactly "true". Simulation mode needs no key at all.
PHARMABRIDGE_LIVE_CALLS=false

# Comma-separated E.164 numbers that live mode may dial. Every other number is refused server-side.
# Use phones you own or are authorized to call, e.g. a teammate acting as the pharmacist.
PHARMABRIDGE_ALLOWED_NUMBERS=

# Required for live calls: an operator must provide this code in the UI before any live call.
# Also required to open call records (/records), in every environment.
PHARMABRIDGE_OPERATOR_CODE=

# Required for live calls: a random 32+ character secret used to sign short-lived call-record access tokens.
# Generate one locally, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PHARMABRIDGE_ACCESS_TOKEN_SECRET=

# Recommended for a hosted simulation-only demo so encrypted simulated-call IDs survive serverless instances.
# If unset, the access-token secret or CALL-E key is used; local no-key simulation uses an ephemeral process secret.
PHARMABRIDGE_SIMULATION_TOKEN_SECRET=

# Optional: public https base URL so CALL-E can deliver terminal webhooks to /api/webhook.
PUBLIC_BASE_URL=
