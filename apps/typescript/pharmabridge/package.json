{
  "name": "pharmabridge",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaBridge: a CALL-E phone agent that finds shortage medications physically in stock nearby, secures a hold, and prepares the prescriber handoff.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
