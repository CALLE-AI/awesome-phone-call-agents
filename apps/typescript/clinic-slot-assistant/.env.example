# Demo mode works without credentials. Never commit .env.local.
CALLE_API_KEY=
# Leave false until you are ready to make an authorized real test call.
CALLE_LIVE_ENABLED=false
# One consenting test volunteer; international E.164 format. Never a real patient list.
CALLE_TEST_PHONE=
# Live testing is local only. Vercel builds force simulation and need none of these values.
