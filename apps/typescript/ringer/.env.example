# CALL-E credentials (server-side only — never exposed to the browser).
# Get a key at https://dashboard.heycall-e.com/account/api-keys
#
# Setting a server key here is OPTIONAL: Ringer also supports BYOK, where each
# user pastes their own key in Settings and it is sent per-request, never stored.

CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Access secret that GATES the shared server key above. Required whenever
# CALLE_API_KEY is set: without it the shared key is "locked" and callers must
# use their own key (BYOK) — this stops strangers from spending your CALL-E
# account on a public deployment. Clients send it as `x-ringer-app-secret`
# (entered once in Settings). Generate any long random string.
CALLE_APP_SECRET=

# Optional: opt into current unsigned terminal webhook delivery. CALL-E does
# not send a secret or signature headers. This app validates event-ID
# consistency and logs only bounded IDs; its live UI remains polling-based.
# See https://docs.heycall-e.com/#/webhooks
CALLE_WEBHOOK_URL=

# Scheduled / recurring calls (optional).
# These fire server-side via a cron, so they need a durable store (Vercel KV /
# Upstash Redis) AND a server CALLE_API_KEY above. Without them, Ringer falls
# back to in-browser reminders. Provisioned automatically when you add Vercel
# KV to the project; or paste Upstash REST credentials directly.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# CRON_SECRET protects /api/cron/run-due. Set it and Vercel Cron sends it as a
# Bearer token; requests without it are rejected. Generate any long random string.
CRON_SECRET=
