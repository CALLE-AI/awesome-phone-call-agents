{
  "name": "ringer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx scripts/dev-api.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "verify": "tsx --tsconfig tsconfig.app.json scripts/verify-demo.ts",
    "verify:api": "tsx --tsconfig tsconfig.app.json scripts/verify-api.ts",
    "verify:render": "esbuild scripts/verify-render.tsx --bundle --platform=node --format=cjs --tsconfig=tsconfig.app.json --external:pdfjs-dist --external:pdfjs-dist/* --outfile=node_modules/.cache/verify-render.cjs && node node_modules/.cache/verify-render.cjs",
    "verify:all": "pnpm build && pnpm typecheck:api && pnpm verify && pnpm verify:api && pnpm verify:render"
  },
  "dependencies": {
    "@call-e/calle": "^0.7.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
