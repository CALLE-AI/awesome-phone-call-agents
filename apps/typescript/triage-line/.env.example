# Copy this file to .env and fill in your real values. .env is gitignored.

# Call mode:
#   mock   -> all simulated (free), gradual timelapse  (default)
#   live   -> all real calls (needs CALLE_API_KEY)
#   hybrid -> REAL_NODE_IDS are real, the rest simulated
CALL_MODE=mock

# Max concurrent calls in fan-out. Keep at 1 for a first live validation.
MAX_CONCURRENCY=8

# Timelapse: mock calls complete gradually between these bounds (ms).
MOCK_MIN_DELAY_MS=4000
MOCK_MAX_DELAY_MS=30000

# --- Live / hybrid call settings (unused in mock mode) ---
# CALL-E API key from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# In hybrid mode, which node ids are placed as real calls.
REAL_NODE_IDS=reachback-1

# Comma-separated E.164 numbers for the welfare-check recipients.
# Leave empty to use the built-in demo placeholders (mock only).
# Example: REACHBACK_PHONES=+14155551234,+14155555678
REACHBACK_PHONES=

# Region and locale for the configured numbers above (defaults: US / en-US).
# India: IN + en-IN. See CALL-E supported regions for others.
REACHBACK_REGION=
REACHBACK_LOCALE=

# Escalation targets:
#   GP_PHONE                - called when a resident reports needing help
#   EMERGENCY_CONTACT_PHONE - called when a resident is unreachable (silence)
GP_PHONE=
EMERGENCY_CONTACT_PHONE=
