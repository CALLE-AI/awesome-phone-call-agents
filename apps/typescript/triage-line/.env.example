# Copy this file to .env and fill in your real values. .env is gitignored.
#
# CALL-E API key. Get one from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# CALL-E API base URL.
CALLE_BASE_URL=https://api.heycall-e.com

# When true, the executor uses the simulated CALL-E (mock/calle-mock.ts)
# instead of the real @call-e/calle SDK. Set to false only for live calls.
USE_MOCK=true

# Max concurrent calls for fan-out execution (respect CALL-E limits when live).
# Keep this at 1 for your first live validation.
MAX_CONCURRENCY=1

# Comma-separated E.164 numbers for the Reachback welfare-check recipients.
# Leave empty to use the built-in demo placeholders (mock only).
# Example: REACHBACK_PHONES=+14155551234,+14155555678
REACHBACK_PHONES=

# Region and locale for the configured numbers above (defaults: US / en-US).
# India: IN + en-IN. See CALL-E supported regions for others.
REACHBACK_REGION=
REACHBACK_LOCALE=

# The GP / clinic number a "needs help" welfare result escalates to.
GP_PHONE=
