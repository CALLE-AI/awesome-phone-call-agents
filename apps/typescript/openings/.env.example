# Running mode: live | dry-run | fake
#   live    — real phone calls through the CALL-E Developer API
#   dry-run — deterministic simulated outcomes, no dialing
#   fake    — fake caller used by tests
OPENINGS_CALL_MODE=dry-run

# Storage: sqlite | memory
#   sqlite — persistent database (production; put the file on a volume)
#   memory — in-memory store (tests / previews)
OPENINGS_STORE=memory
OPENINGS_DB_PATH=/data/openings.db

# Set to 1 to disable the standing-watch scheduler in the server process.
OPENINGS_DISABLE_SCHEDULER=0

# Only needed when OPENINGS_CALL_MODE=live
CALLE_API_KEY=calle_live_key_here
CALLE_BASE_URL=https://api.heycall-e.com
