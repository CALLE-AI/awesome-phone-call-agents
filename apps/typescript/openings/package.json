{
  "name": "openings",
  "version": "0.1.0",
  "private": true,
  "description": "Standing availability watch for healthcare access: calls listed providers to find appointments that actually exist, and flags the ghost listings that do not.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:live": "bash scripts/verify-live.sh",
    "build:scheduler": "node scripts/build-scheduler.mjs",
    "scheduler": "node dist-scheduler/scheduler.js",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@call-e/calle": "0.6.0",
    "better-sqlite3": "11.8.1",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.0.17",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "esbuild": "0.25.12",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "tailwindcss": "4.0.17",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
