# CALL-E Credentials (Optional for local testing; fixture replay works out-of-the-box)
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_DEFAULT_CALLER_ID=

# Outbound Recipient Destination Allowlist (Comma-separated ASCII E.164 phone numbers)
ALLOWED_LIVE_RECIPIENTS=
CALLE_SMOKE_PHONE=

# Server Config
PORT=3000
NODE_ENV=development

# Live Dispatch Authorization (Required when making live carrier dispatches via API)
# Live calls fail closed (401 Unauthorized) if this secret is missing or unauthenticated.
VAULTCALL_DISPATCH_SECRET=
