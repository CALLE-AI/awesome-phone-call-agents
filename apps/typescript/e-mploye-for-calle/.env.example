# Server-only CALL-E configuration. Never expose CALLE_API_KEY to Vite.
# Live mode activates only when the flag, API key, trusted origin, authorized E.164 test phone, region, and locale are present.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_LIVE_ENABLED=false
CALLE_TEST_PHONE=
CALLE_TEST_REGION=
CALLE_TEST_LOCALE=
CALLE_DEFAULT_LANGUAGE=en-US
CALLE_DEFAULT_REGION=MX
# Separate bearer token for the live-capable app API. Never reuse CALLE_API_KEY.
EMPLOYE_API_TOKEN=
EMPLOYE_PORT=8787
# Local development binds to loopback by default; production containers bind all interfaces.
# EMPLOYE_HOST=127.0.0.1
EMPLOYE_STATE_FILE=./data/state.json

# Optional Vite setting for a separately hosted API.
# VITE_API_ORIGIN=
# Optional private-build setting: sends EMPLOYE_API_TOKEN from the browser to the app API.
# VITE_EMPLOYE_API_TOKEN=
