# Server-only CALL-E configuration. Never expose CALLE_API_KEY to Vite.
# Live mode activates only when the flag, API key, authorized E.164 test phone, region, and locale are present.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_LIVE_ENABLED=false
CALLE_TEST_PHONE=
CALLE_TEST_REGION=
CALLE_TEST_LOCALE=
CALLE_DEFAULT_LANGUAGE=en-US
CALLE_DEFAULT_REGION=MX
EMPLOYE_PORT=8787
# Local development binds to loopback by default; production containers bind all interfaces.
# EMPLOYE_HOST=127.0.0.1
EMPLOYE_STATE_FILE=./data/state.json

# Optional Vite setting for a separately hosted API.
# VITE_API_ORIGIN=
