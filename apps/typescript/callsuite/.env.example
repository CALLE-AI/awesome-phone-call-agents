# Create an API key at https://dashboard.heycall-e.com.
CALLE_API_KEY=calle_live_replace_me

# Use only a number you own or are explicitly authorized to test, in E.164 format.
CALLSUITE_TEST_PHONE=+15550101234

# Exact comma-separated targets authorized for testing. Wildcards and prefixes are rejected.
CALLSUITE_AUTHORIZED_TARGETS=+15550101234

# Explicit routing hints. The first-call spike defaults to IN / en-IN when omitted.
CALLSUITE_TEST_REGION=IN
CALLSUITE_TEST_LOCALE=en-IN
