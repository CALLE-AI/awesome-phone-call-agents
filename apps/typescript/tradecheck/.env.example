# ─────────────────────────────────────────────────────────────────────────────
# TradeCheck — Environment Variables
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored so your secrets will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Call-E (AI Voice Verification) ───────────────────────────────────────────
# Used to place live outbound verification calls to suppliers.
# Sign up at https://heycall-e.com to get your API key and base URL.
CALLE_API_KEY=
CALLE_BASE_URL=
# Exact HTTPS origin of your deployed app (e.g. https://tradecheck.example.com).
# Required to enable live outbound calls — leave blank to run in fake/preview-only mode.
TRADECHECK_ALLOWED_ORIGIN=


# ── Google Gemini (LLM) ───────────────────────────────────────────────────────
# Powers the AI Copilot chat and dynamic call transcript simulation.
# Get your key at https://aistudio.google.com/app/apikey
# You can supply multiple keys (comma-separated) to rotate across them and
# avoid free-tier rate limits, e.g. GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=

# ── India: GSTIN Verification (Sandbox API) ───────────────────────────────────
# Used to verify Indian suppliers via their GSTIN (GST Identification Number).
# Sign up at https://sandbox.co.in to obtain your API key and auth token.
SANDBOX_API_KEY=
SANDBOX_AUTH_TOKEN=

# ── Nigeria: CAC Registry Lookup ──────────────────────────────────────────────
# Two providers are used together to maximise lookup coverage for Nigerian
# companies via the Corporate Affairs Commission (CAC) registry.
#
# RapidAPI — primary lookup (by RC number or company name):
# Subscribe to the "Business and Company Name API" on https://rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_HOST=business-and-company-name-api.p.rapidapi.com

# Apify — fallback scraper for deeper CAC lookups:
# Sign up at https://apify.com and create an API token.
APIFY_API_KEY=

# ── United Kingdom: Companies House ───────────────────────────────────────────
# Used to verify UK suppliers via the official Companies House REST API.
# Register a free account at https://developer.company-information.service.gov.uk
# and create an application to get your API key.
COMPANIES_HOUSE_API_KEY=

# ── China: CNBizAPI ───────────────────────────────────────────────────────────
# Used to look up Chinese suppliers by company name or USCC (Unified Social
# Credit Code). Sign up at https://cnbizapi.com for an API key.
#
# IMPORTANT: CNBizAPI is a third-party data aggregator — it is NOT a direct
# connection to the Chinese government USCC registry. Results should be treated
# as indicative only and are not verified government data.
CNBIZAPI_KEY=

# ── United States: SEC EDGAR ───────────────────────────────────────────────────────
# Used to verify US companies via the SEC's public EDGAR database.
# No API key is required. The SEC EDGAR REST API (data.sec.gov and efts.sec.gov)
# is freely available to the public with no authentication.
# Docs: https://www.sec.gov/developer

# ── Demo Mode / Live Calling ──────────────────────────────────────────────────
# ALL call tools run in PREVIEW (fake/simulated) mode by default.
# Live outbound calls are only placed when ALL of the following are true:
#   1. TRADECHECK_ALLOWED_ORIGIN is set to the exact HTTPS origin of your
#      deployed app (e.g. https://tradecheck.example.com). If this is not set,
#      fake-only mode is enforced permanently — no live calls are possible.
#   2. The request Origin (or Referer) header matches TRADECHECK_ALLOWED_ORIGIN.
#   3. The request carries the header "X-TradeCheck-Live-Call: approved",
#      which your client must only send after presenting an explicit user
#      confirmation that a real outbound call will be placed.
#
# Fake-only hosting (TRADECHECK_ALLOWED_ORIGIN not set) is acceptable for
# demos and development environments.
#
# Set DEMO_MODE=true to enable AI-simulated transcript generation as a fallback
# when live calls are unavailable or not authorised.
DEMO_MODE=true