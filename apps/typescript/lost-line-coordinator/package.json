{
  "name": "calle-lost-line-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consent-first lost-property route coordinator with evidence-derived matches and adaptive early stopping.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx demo/run-local.ts",
    "lost-line": "node --import tsx src/cli.ts",
    "preview": "node --import tsx src/cli.ts preview --request examples/search.example.json"
  },
  "dependencies": {
    "@call-e/calle": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
