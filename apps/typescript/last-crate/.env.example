CALLE_API_KEY=
LIVE_CALLS_ENABLED=false
# Keep true for hackathon role-play. False enables actual approved pickup coordination.
LIVE_ROLEPLAY=true
# Explicit numbers authorized for this demo, comma-separated E.164.
CALLE_ALLOWED_PHONES=
# Maximum live call creations for this installation, persisted in data/.
MAX_LIVE_CALLS=4
PORT=3210
HOST=127.0.0.1
# Required if binding to a public interface. Use a long random value.
APP_ACCESS_TOKEN=
# The one-command demo reuses the sole allowlisted number unless overridden.
DEMO_PHONE=
DEMO_REGION=LK
DEMO_LOCALE=en-US
DEMO_UTC_OFFSET=+05:30
