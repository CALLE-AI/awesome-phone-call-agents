# Keep this key server-side. Without it, MedRoute runs in safe demo mode.
CALLE_API_KEY=
MEDROUTE_ACCESS_TOKEN=replace-with-a-long-random-operator-token
# Production safeguards: requests/minute per operator+IP, seconds before a pharmacy can be called again.
MEDROUTE_MAX_CHECKS_PER_MINUTE=30
MEDROUTE_LIVE_COOLDOWN_SECONDS=900
# Bound untrusted provider transcript data before it is stored or rendered into a PDF.
MEDROUTE_MAX_TRANSCRIPT_TURNS=200
# Required in production: use a private random value of at least 32 characters.
MEDROUTE_RECIPIENT_HASH_KEY=replace-with-a-separate-long-random-secret
# Bound CPU and memory consumed by on-demand transcript PDF generation per server instance.
MEDROUTE_MAX_CONCURRENT_PDF_JOBS=2
MEDROUTE_PDF_TIMEOUT_MS=30000
MEDROUTE_MAX_PDF_OUTPUT_BYTES=5000000
# Optional CALL-E routing hints. Leave blank to infer from each E.164 phone number.
MEDROUTE_CALL_LOCALE=
MEDROUTE_CALL_REGION=
# Optional result-observation controls. These do not change CALL-E dial-queue time.
MEDROUTE_CALL_RESULT_POLL_MS=750
MEDROUTE_CALL_RESULT_TIMEOUT_MS=600000
# Wait for a late CALL-E attempt/result before saving an incomplete terminal status.
MEDROUTE_CALL_INCOMPLETE_RESULT_GRACE_MS=120000
# Set MEDROUTE_ENV=production only with a PostgreSQL database and an OpenID Connect provider.
# The browser's operator token must be an access token issued for this audience.
MEDROUTE_ENV=development
DATABASE_URL=
MEDROUTE_OIDC_ISSUER=
MEDROUTE_OIDC_AUDIENCE=
MEDROUTE_OIDC_JWKS_URL=
# Tokens must contain these values in scope/scp or roles for protected operations.
MEDROUTE_OIDC_READ_PERMISSION=medroute.read
MEDROUTE_OIDC_LIVE_PERMISSION=medroute.live
PORT=3000
