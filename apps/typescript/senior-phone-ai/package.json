  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
