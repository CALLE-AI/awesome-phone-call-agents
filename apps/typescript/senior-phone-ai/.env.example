# Preview is the safe default. No provider request is made in preview mode.
SENIOR_PHONE_AI_MODE=preview

# Server-only values for explicitly enabled live integrations.
# Leave these blank during preview and offline tests.
OPENAI_API_KEY=
CALLE_API_KEY=
# CALL-E captures the request and SMS consent; the local worker searches after completion.
# Prepare SMS previews without sending; takes precedence over SMS_ENABLED.
CALLE_FOLLOWUP_PREVIEW=false
CALLE_FOLLOWUP_ENABLED=false
CALLE_FOLLOWUP_STORAGE_KEY=
# At least 32 random characters; sent only by the production host scheduler.
SCHEDULER_SECRET=
# Optional import of existing CALL-E call IDs; new calls register automatically.
CALLE_MONITORED_CALL_IDS=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
# Australian SMS pilot: disabled until sender and exact test recipients are configured.
SMS_ENABLED=false
SMS_FROM_NUMBER=
# Comma-separated, explicitly consented Australian mobiles in +614xxxxxxxx format.
SMS_TEST_RECIPIENTS=
# Optional for the local CALL-E demo: delivery status is checked through the Twilio API.
SMS_STATUS_CALLBACK_URL=
SUPABASE_SECRET_KEY=

# Public values must not contain credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
