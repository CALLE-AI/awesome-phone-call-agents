# Preview is the safe default. No provider request is made in preview mode.
SENIOR_PHONE_AI_MODE=preview

# Server-only values for later, explicitly enabled live integrations.
# Leave these blank during the scaffold and offline demo.
OPENAI_API_KEY=
CALLE_API_KEY=
CALLE_MONITORED_CALL_IDS=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SUPABASE_SECRET_KEY=

# Public values must not contain credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
