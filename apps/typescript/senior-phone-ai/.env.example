# Preview is the safe default. No provider request is made in preview mode.
SENIOR_PHONE_AI_MODE=preview

# Server-only values for explicitly enabled live integrations.
# Leave these blank during preview and offline tests.
OPENAI_API_KEY=
CALLE_API_KEY=
# At least 32 random characters; sent only by the production host scheduler.
SCHEDULER_SECRET=
# Optional Vapi in-call search prototype. Disabled independently of CALL-E.
VAPI_SEARCH_ENABLED=false
VAPI_ASSISTANT_ID=
# At least 32 random characters; configure the same Bearer token in Vapi Custom Credentials.
VAPI_WEBHOOK_SECRET=
# Optional import of existing CALL-E call IDs; new calls register automatically.
CALLE_MONITORED_CALL_IDS=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SUPABASE_SECRET_KEY=

# Public values must not contain credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
