# CALL-E credentials (get from https://dashboard.heycall-e.com/account/api-keys)
CALLE_API_KEY=iams_live_xxx
CALLE_BASE_URL=https://api.heycall-e.com
# Optional: reusable published Goal id (Goals API deep-integration path)
CALLE_GOAL_ID=
# Public HTTPS URL CALL-E will POST terminal webhook events to (e.g. ngrok/deploy URL)
CALLE_WEBHOOK_URL=
# Set to 1 to allow REAL outbound calls (requires KYC-activated account). Default 0 = mock mode.
GOODFAITH_LIVE=0
# Bearer token a caller MUST present (Authorization: Bearer <token>) to drive live-privileged
# endpoints: live quote creation and private quote/event reads. Required in live mode
# (unset = live access refused, fail-closed). Not needed for the public mock demo.
GOODFAITH_API_TOKEN=
# Comma-separated E.164 numbers authorized to actually be dialed in live mode (empty = none).
GOODFAITH_ALLOWED_RECIPIENTS=
# Optional shared secret CALL-E must echo (X-GoodFaith-Webhook-Secret) on webhook posts.
GOODFAITH_WEBHOOK_SECRET=
# Optional: Google Places / Maps API key for live clinic sourcing (falls back to seeded list)
PLACES_API_KEY=
