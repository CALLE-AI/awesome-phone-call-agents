# still-covered configuration. Copy to .env (git-ignored) and fill in.
# Dry-run is the default and needs none of this: `npm run demo` works with an empty file.

# --- live mode -------------------------------------------------------------
# A real call needs all three of: SC_MODE=live, CALLE_API_KEY, and --confirm on the command line.
SC_MODE=dry-run
CALLE_API_KEY=

# Comma-separated E.164 numbers. In live mode nobody else is dialled, whatever the registry says.
# Always set this for a rehearsal.
SC_LIVE_ALLOWLIST=

# --- who is calling --------------------------------------------------------
SC_STATE=example-state
SC_TIMEZONE=America/New_York

# --- pacing and limits -----------------------------------------------------
SC_QUIET_HOURS=21:00-08:00
SC_WAVE_SIZE=4
# Calls per person per campaign, including the redial. Values above 3 are rejected.
SC_MAX_ATTEMPTS=2

# --- dashboard and webhooks ------------------------------------------------
SC_PORT=4800
SC_FAKE_PORT=4848
# Set to your tunnel URL to receive CALL-E webhooks. Setting it auto-generates a dashboard token.
SC_PUBLIC_URL=
SC_DASHBOARD_TOKEN=
