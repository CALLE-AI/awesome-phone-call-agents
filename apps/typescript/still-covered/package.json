{
  "name": "calle-still-covered",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Medicaid work-requirement exemption screener on CALL-E: phones the enrollees the state's own data could not clear, explains the new rule in their language, screens for exemptions with a few plain questions, and turns every answer into a caseworker-reviewed worklist.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:failures": "node --import tsx --test test/robustness.test.ts",
    "sc": "node --import tsx src/cli.ts",
    "plan": "node --import tsx src/cli.ts plan --registry data/enrollees.sample.csv --as-of 2026-09-14 --dry-run",
    "demo": "node --import tsx src/cli.ts run --registry data/enrollees.sample.csv --as-of 2026-09-14 --fast --dry-run",
    "serve": "node --import tsx src/cli.ts serve --dry-run",
    "fake-server": "node --import tsx src/cli.ts fake-server"
  },
  "dependencies": {
    "@call-e/calle": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
