# From https://dashboard.heycall-e.com/account/api-keys
# Only the scripts that touch the network need this. The checker, the tests and
# the doc generator run without it.
CALLE_API_KEY=

# Production is the default. The SDK README also documents a test host:
#   https://test-api.heycall-e.com
# Whether the test host consumes call credits is unverified.
# CALLE_BASE_URL=https://api.heycall-e.com

# --- the counter probes: peek, watch, headroom, meter ---
# These read the rate-limit counter by sending a well-formed request to a region
# the account cannot call, so the planner refuses it and nothing is dialled.
# Use a number you control, and check the region is still unsupported before
# running: if coverage arrives, the probe places a real call to it.
CALLE_UNSUPPORTED_PHONE=
CALLE_UNSUPPORTED_REGION=PE
CALLE_UNSUPPORTED_LOCALE=es-PE

# --- the connected-call probe: live ---
# Defaults to +12763229632, the English testing hotline CALL-E published on
# 7 September 2026. Override only to dial a number you control.
# CALLE_TEST_PHONE=+12763229632
# CALLE_TEST_REGION=US
# CALLE_TEST_LOCALE=en-US
