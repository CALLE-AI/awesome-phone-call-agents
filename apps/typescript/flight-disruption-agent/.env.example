# Call mode. dry-run (default) never contacts CALL-E and uses scripted results.
#   dry-run | sdk | cli
CALLE_MODE=dry-run

# sdk mode: Developer API key from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# sdk and cli modes: every live call is redirected to this one number.
# The fixture passengers use fictional numbers and are never dialed.
# Only put a number here whose owner has agreed to receive a test call.
# Indonesian (+62) numbers are currently refused by CALL-E.
LIVE_DEMO_PHONE=

# sdk and cli modes: set to yes to confirm the owner of LIVE_DEMO_PHONE agreed to
# receive these test calls. Live mode refuses to start without it.
LIVE_DEMO_PHONE_CONSENT=

# "Check with CALL-E" (any mode): sends a call's exact task to CALL-E's planner through
# your `calle auth login`. Planning never dials. Set your own number in a supported region.
CALLE_PLAN_PHONE=
# Set to off to hide the Check with CALL-E buttons.
CALLE_PLAN_CHECK=

# Maximum live calls per server run (protects free call credits).
LIVE_CALL_BUDGET=3

# Shared secret for POST /api/webhooks/airline-ops (HMAC-SHA256, see README).
# Dry run falls back to a demo secret when empty; sdk and cli modes need a real one.
AIRLINE_WEBHOOK_SECRET=

# Shared secret for POST /api/webhooks/channel, used by the chat, web form, and phone line
# integrations (same HMAC scheme as the ops webhook, header x-channel-signature).
# Dry run falls back to a demo secret when empty; sdk and cli modes need a real one.
CHANNEL_WEBHOOK_SECRET=
# Where the desk posts later request updates (signed the same way). https, or http to this machine.
# Try it with `npm run fake-channel` and CHANNEL_NOTIFY_URL=http://127.0.0.1:4330/updates
CHANNEL_NOTIFY_URL=

# Optional pull feed for airline systems that cannot call the webhook.
# GET <url>?cursor=... must return { "events": [...], "next_cursor": "..." }.
# Try it with `npm run fake-feed` and AIRLINE_FEED_URL=http://127.0.0.1:4320/events
AIRLINE_FEED_URL=
# Sent as a bearer token; only over https or to this machine.
AIRLINE_FEED_TOKEN=
AIRLINE_FEED_POLL_SECONDS=30

# Server bind address. The dashboard only accepts loopback clients unless OPERATOR_TOKEN
# is set; the server refuses to bind to a non-loopback address without one.
HOST=127.0.0.1
PORT=4310

# Optional operator password for the dashboard (HTTP Basic, any user name).
OPERATOR_TOKEN=

# Passenger request cutoffs run on a demo clock that starts here (the fixtures fly on
# 20 September 2026). Set DEMO_NOW=real to use the wall clock.
DEMO_NOW=2026-09-19T09:00:00+07:00
