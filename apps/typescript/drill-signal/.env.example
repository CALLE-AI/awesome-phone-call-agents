# DrillSignal environment (placeholders only — do not commit real secrets)

# Server port (default 3847)
PORT=3847
DRILL_SIGNAL_PORT=3847

# Bind host (default 127.0.0.1). Non-loopback binds require DRILL_SIGNAL_OPERATOR_TOKEN.
DRILL_SIGNAL_BIND_HOST=127.0.0.1

# Required when DRILL_SIGNAL_BIND_HOST is not loopback — protects mutating API routes.
# DRILL_SIGNAL_OPERATOR_TOKEN=<your-operator-token>

# Local JSON store directory (created automatically)
DRILL_SIGNAL_DATA_DIR=.data

# Hours to retain full E.164 on active drills before purge/redaction (default 24)
DRILL_SIGNAL_ACTIVE_TTL_HOURS=24

# Live CALL-E mode only — keep on server, never in client or drill files
CALLE_API_KEY=<your-calle-api-key>
CALLE_BASE_URL=https://api.heycall-e.com

# Optional: allow additional exact hostnames for fake-server testing (comma-separated)
# CALLE_ALLOWED_HOSTS=staging.example.com

# Set to 0 to disable auto-started embedded fake for fake-server mode
# DRILL_SIGNAL_EMBEDDED_FAKE=1

# Fictional reserved sample numbers for simulation (NANP 555-010-XXXX)
# Primary example: +15550100001
# Backup example:  +15550100003
