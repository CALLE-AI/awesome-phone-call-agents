# Local operator live mode only. Judge mode needs none of these.
# Server-side only; never expose to the browser.
CALLE_API_KEY=
# replay | live — anything but "live" runs deterministic replays only
CHANGELOCK_MODE=replay
CHANGELOCK_DB_PATH=./data/changelock.db
# live mode additionally refuses to dial unless both allowlists are nonempty
# and the trusted contact's E.164 number and region are listed (comma-separated)
CHANGELOCK_LIVE_CONTACT_ALLOWLIST=
CHANGELOCK_LIVE_REGION_ALLOWLIST=US
