
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CALL-E API Configuration for live voice phone calls
# Get your API key from CALL-E (https://heycall-e.com)
CALLE_API_KEY=""
CALLE_ENABLED="true"

# When true, CALL-E routes the emergency rescue call directly to the tester's phone number
DEMO_MODE="true"

