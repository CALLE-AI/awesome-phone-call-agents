# Server-only CALL-E credential. Never expose this value to browser code.
CALLE_API_KEY=

# Live calling fails closed unless all four settings are configured.
# Comma-separated E.164 numbers that this deployment may call.
CALLE_ALLOWED_NUMBERS=
READYLINE_LIVE_ENABLED=false

# Use a random secret with at least 20 characters. This is not a CALL-E credential.
READYLINE_OPERATOR_KEY=
