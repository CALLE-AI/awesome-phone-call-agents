# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL. Any Postgres works; this project runs on Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon gives you two hostnames: a POOLED one (…-pooler.…) and a direct one.
# The app should use the pooled URL above. Migrations must NOT: `prisma migrate
# deploy` takes a session-scoped postgres advisory lock, and through pgbouncer
# that lock is left behind on an idle pooled backend, after which every later
# migration fails with P1002 "Timed out trying to acquire a postgres advisory
# lock". Run migrations against the direct hostname instead:
#   DATABASE_URL="<direct url>" npx prisma migrate deploy

# Clerk. Omit BOTH and Clerk runs in keyless mode, provisioning a temporary
# development instance on first boot - fine for a local look, not for a demo
# you care about, since the sign-in screen will say "My Application".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ─── Optional - each degrades gracefully ─────────────────────────────────────

# Plan generation. Without it the wizard falls back to a built-in sample plan.
ANTHROPIC_API_KEY=""
# Only for an identity-linked key (sk-ant-api0…), which the API rejects with a
# 400 unless the request names the workspace it acts in. A plain workspace key
# needs nothing here. Find the id in the Console URL of the workspace.
ANTHROPIC_WORKSPACE_ID=""

# CALL-E voice agent. Without CALLE_API_KEY every call is SIMULATED: it returns
# instantly, is stored with mock: true, and is labelled SIMULATED in the UI.
CALLE_API_KEY=""
CALLE_BASE_URL="https://api.heycall-e.com"
# Real numbers per catalogue id, as a JSON object. This is how a fan-out dials
# twelve DIFFERENT lines: without it every target falls back to the number
# below, the batch route de-duplicates them, and only one call is placed.
# Numbers are kept here rather than in app/radio/_data.ts because that file is
# public demo data that ships to the browser.
#   ARC_CONTACTS='{"city-fm-89-khi":"+923001234567","fm-101-national":"+923009876543"}'
ARC_CONTACTS=""

# E.164, e.g. +923001234567 - dialled when a target has no number of its own.
# DEVELOPMENT ONLY: this fallback is ignored when NODE_ENV=production, because
# one server-side number would make every user's call ring the same handset.
# Deployed, the caller must type the number they want Arc to ring.
CALLE_DEMO_PHONE=""

# Billing. Without these, checkout and plan upgrades are inert.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_MONTHLY_PRICE_ID=""
STRIPE_STARTER_ANNUAL_PRICE_ID=""
STRIPE_GROWTH_MONTHLY_PRICE_ID=""
STRIPE_GROWTH_ANNUAL_PRICE_ID=""
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=""
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=""

# Local payments (JazzCash). Optional.
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Reconcile cron (/api/calle/reconcile). Vercel sends this as a bearer token on
# scheduled invocations; without it the route refuses to run rather than
# reading call records unauthenticated.
CRON_SECRET=""

# How long the browser waits for one call before handing it to the reconcile
# cron. Defaults to 20 minutes - CALL-E's queue reached 11m48s on 31 Aug.
NEXT_PUBLIC_CALLE_MAX_WAIT_MS=""

# Most targets one batch may dial. Defaults to 12.
CALLE_MAX_BATCH=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk org ids that may see sample billing data, comma-separated. Anything not
# listed is a real workspace and sees the truth: no invoices exist. Opt-in on
# purpose - a default of "demo" eventually shows invented invoices to a paying
# customer.
ARC_DEMO_ORG_IDS=""

# Reopens the /dev/* harness in production. Closed by default: it renders
# replayed calls and component galleries, none of which belong one guessed URL
# away from a customer. Set to 1 only when you deliberately need it there.
ARC_ENABLE_DEV_PAGES=""
