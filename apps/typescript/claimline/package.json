{
  "name": "claimline",
  "version": "0.1.0",
  "private": true,
  "description": "Insurance FNOL intake and claim-status chasing over the phone with CALL-E. No-call fixture mode by default.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "claimline": "./dist/cli.js",
    "claimline-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@call-e/calle": "^0.7.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
