# ClaimLine environment configuration
# Copy to .env and adjust. SAFE DEFAULT: with no CALLE_API_KEY the app runs in
# fixture mode and places NO real calls. Set a key (and/or CLAIMLINE_MODE=live)
# to place real calls.

# fixture = no real calls. live = place real calls via CALL-E.
# Leave unset to auto-select: live when CALLE_API_KEY is present, else fixture.
# CLAIMLINE_MODE=fixture

# Required for live calls. Get one at https://dashboard.heycall-e.com/account/api-keys
# On a hosted instance set this in the platform's secret env, NEVER in the repo.
# CALLE_API_KEY=calle_live_key

# Optional CALL-E API base override (defaults to the SDK default).
# CALLE_BASE_URL=https://api.heycall-e.com

# HTTP server port for the dashboard + webhook receiver.
PORT=8787

# Path to the SQLite database file.
CLAIMLINE_DB=./data/claimline.db

# Minimum completion-confidence score (0..1) to treat a result as trusted.
CLAIMLINE_CONFIDENCE_THRESHOLD=0.6

# Display name used in the call disclosure ("...calling on behalf of X").
CLAIMLINE_INSURER_NAME=ClaimLine Insurance

# ---- Authentication ---------------------------------------------------------
# Owner login uses the SERVER's CALLE_API_KEY to place calls. Guests log in and
# supply their own key. Owner login is DISABLED unless a password is set here.
# Keep the real password in your host's secret env, NEVER in the repo.
CLAIMLINE_OWNER_USER=garglakshay
# CLAIMLINE_OWNER_PASS=set-in-host-env-only

# Secret used to sign session cookies. Set a long random value in production.
# CLAIMLINE_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Live-mode webhooks (optional) -----------------------------------------
# Public base URL CALL-E should post terminal webhooks to.
# CLAIMLINE_PUBLIC_BASE_URL=https://your-host.example

# Shared secret used to authenticate CALL-E terminal webhooks (optional).
# CLAIMLINE_WEBHOOK_SECRET=change-me

# ---- Integrations (optional; all demo-safe) --------------------------------
# Stripe secret key for demo payouts (TEST mode, e.g. sk_test_...). When unset,
# payouts are simulated and always "succeed" — no real money moves.
# STRIPE_SECRET_KEY=sk_test_...

# Post the autopilot end-of-case report to Slack and/or Teams via an incoming
# webhook. When neither is set, the report is delivered by a simulated notifier.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx

# Seed demo data on an empty boot (default true). Set false to start empty.
# CLAIMLINE_AUTOSEED=true
