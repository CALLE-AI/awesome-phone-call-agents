DATABASE_URL=./dev.db
OPENROUTER_API_KEY=
CALLE_API_KEY=
# Required safety switch for any public deployment. Leave false (or unset)
# so the app cannot place real CALL-E calls to submitted numbers. Real
# calls require ALLOW_REAL_CALLS=true, CALLE_DRY_RUN=false, a matching
# OPERATOR_SECRET on the request, and an allowlisted recipient.
ALLOW_REAL_CALLS=false
CALLE_DRY_RUN=true
# Shared secret for routes that place calls or return stored records.
# Send as `Authorization: Bearer <secret>` or JSON field `operatorSecret`.
OPERATOR_SECRET=
# Comma-separated ASCII E.164 numbers that may receive a real call.
ALLOWED_RECIPIENTS=
