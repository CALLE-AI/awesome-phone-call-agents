# --- Demo mode (default, safe — no API key needed) ---
CALLE_MODE=dry_run

# --- Live mode (dials real customers — off by default, do not enable casually) ---
# CALLE_MODE=live
# CALLE_API_KEY=your_actual_api_key_here
# CALLE_LIVE_CONFIRM=I_UNDERSTAND_THIS_DIALS_REAL_CUSTOMERS
# ALLOWED_RECIPIENT_NUMBERS=+2340000000001,+2340000000002
#
# Live mode also requires each individual POST /orders request to include:
#   X-Confirm-Live-Call: I_CONFIRM_LIVE_CALL_FOR_THIS_ORDER
# Server-level live mode alone does not authorize any single call.

# --- Required in all modes ---
# NOTE: "changeme_dev_only" only works for local (127.0.0.1) requests while
# CALLE_MODE=dry_run. It is automatically rejected in live mode or when the
# server is reached from a non-loopback address — set a real, unique value
# before deploying anywhere reachable.
DASHBOARD_API_KEY=changeme_dev_only

PORT=3000