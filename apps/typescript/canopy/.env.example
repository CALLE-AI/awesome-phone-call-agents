# Canopy never places a real call unless CANOPY_MODE=live AND CALLE_API_KEY are both set
# AND the run command is given --confirm. The default is dry-run against a local fake CALL-E server.
CANOPY_MODE=dry-run

# CALL-E Developer API key (Dashboard -> API keys). Only read in live mode. Never commit it.
CALLE_API_KEY=

# Optional: override the CALL-E API base URL (defaults to https://api.heycall-e.com in live mode).
# CALLE_BASE_URL=

# Public HTTPS URL of this app when running live, so CALL-E can deliver webhooks
# (for example an ngrok tunnel). If unset, Canopy relies on polling only, which also works.
# Setting it turns on a dashboard token; the run prints the tokenised dashboard URL.
# CANOPY_PUBLIC_URL=https://example-tunnel.ngrok.app
# CANOPY_DASHBOARD_TOKEN=            # optional explicit token; auto-generated when a public URL is set

# Local bind address and ports. Use CANOPY_HOST=0.0.0.0 only for a hosted dry-run demo.
CANOPY_HOST=127.0.0.1
CANOPY_PORT=4700
CANOPY_FAKE_PORT=4747

# Organisation name spoken in the disclosure line, and the local emergency number to recite.
CANOPY_ORG="Maricopa County Emergency Management"
CANOPY_EMERGENCY_NUMBER=911

# Wave size: how many people are planned per wave. In per-person mode each person is one CALL-E task,
# placed in parallel per wave; in batch mode the whole wave is one task with recipients[].
CANOPY_WAVE_SIZE=4
# CANOPY_TASK_MODE=per-person        # live default: per-person; dry-run default: batch

# Calling window. Live roll calls inside quiet hours are refused unless the playbook is life-safety
# and the operator passes --override-quiet-hours "<reason>". Use "none" to disable.
CANOPY_QUIET_HOURS=21:00-07:00
# CANOPY_TIMEZONE=Asia/Kolkata       # IANA zone; defaults to the system zone

# Optional live safety allowlist: comma-separated E.164 numbers Canopy may dial in live mode.
# When set, any registry row whose phone is not on this list is skipped, even with consent.
# CANOPY_LIVE_ALLOWLIST=+14155550100,+14155550101
