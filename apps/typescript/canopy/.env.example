# Canopy never places a real call unless CANOPY_MODE=live AND CALLE_API_KEY are both set
# AND the run command is given --confirm. The default is dry-run against a local fake CALL-E server.
CANOPY_MODE=dry-run

# CALL-E Developer API key (Dashboard -> API keys). Only read in live mode. Never commit it.
CALLE_API_KEY=

# Optional: override the CALL-E API base URL (defaults to https://api.heycall-e.com in live mode).
# CALLE_BASE_URL=

# Public HTTPS URL of this app when running live, so CALL-E can deliver webhooks
# (for example an ngrok tunnel). If unset, Canopy relies on polling only, which also works.
# CANOPY_PUBLIC_URL=https://example-tunnel.ngrok.app

# Local ports.
CANOPY_PORT=4700
CANOPY_FAKE_PORT=4747

# Organization name spoken in the disclosure line, and the local emergency number to recite.
CANOPY_ORG="Maricopa County Emergency Management"
CANOPY_EMERGENCY_NUMBER=911

# Wave size: how many people are placed in one CALL-E call task at a time.
CANOPY_WAVE_SIZE=4

# Optional live safety allowlist: comma-separated E.164 numbers Canopy may dial in live mode.
# When set, any registry row whose phone is not on this list is skipped, even with consent.
# CANOPY_LIVE_ALLOWLIST=+14155550100,+14155550101
