PORT=3000
BIND_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/readycheck.sqlite
# Live mode is disabled unless ALL controls below are configured.
CALLE_API_KEY=
# Optional known test call for read-only access verification; never creates a call.
CALLE_VERIFICATION_CALL_ID=
LIVE_CALLS_ENABLED=false
# Configure consenting test participants server-side. Do not use sample numbers.
TEST_RECIPIENTS_JSON=[]
# Example shape: [{"id":"test-1","name":"Consenting test participant","phone":"<E164>","consentRef":"<consent record>","timezone":"America/Chicago"}]
# Server administrator adds exact account IDs shown in Connection settings.
LIVE_USER_IDS=
MAX_CALLS_PER_DAY=10
MAX_CALLS_PER_USER_DAY=3
CALL_WINDOW_START=9
CALL_WINDOW_END=20
TRANSCRIPT_RETENTION_DAYS=30
