{
  "name": "relaygoal",
  "version": "0.1.0",
  "private": true,
  "description": "Verified phone-outcome relay for CALL-E: type a goal, the agent makes the whole call, you get an answer grounded in exact transcript quotes. Accessibility relay is the flagship vertical. Built on a mocked call path (FakeCalle) \u2014 swap in @call-e/calle to go live.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "vitest run test/eval.test.ts --reporter=verbose"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.5"
  },
  "peerDependenciesMeta": {
    "@call-e/calle": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@call-e/calle": "^0.7.0"
  }
}
