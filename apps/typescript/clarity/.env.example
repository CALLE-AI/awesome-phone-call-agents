# replay uses the synthetic fixture without API keys or phone calls.
# Set live to analyze applications with Gemini and place calls through CALL-E.
DEMO_MODE=replay

# CALL-E Developer API
CALLE_API_KEY=
# Optional; defaults to https://api.heycall-e.com
CALLE_BASE_URL=

# Google Gemini API — used by the analyzer
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Recipient for npm run call:capture only, in E.164 (e.g. +15555550100).
# The app always reads the recipient from the submitted resume or written answers.
DEMO_PHONE_E164=

# Optional public HTTPS webhook URL. Polling works without it.
CALLE_WEBHOOK_URL=
