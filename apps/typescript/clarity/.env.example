# No provider requests unless explicitly set to live.
DEMO_MODE=replay

# Required in every mode, including replay. Generate at least 32 random characters.
# Browser login: username clarity, password this token. Never use a provider key here.
# Generate with: openssl rand -hex 32
CLARITY_AUTH_TOKEN=
# Exact browser origin for CSRF checks; set your HTTPS origin for remote hosting.
CLARITY_ORIGIN=http://localhost:3000

# CALL-E credentials are sent only to https://api.heycall-e.com; redirects are refused.
CALLE_API_KEY=
# Optional compatibility setting: only https://api.heycall-e.com (with optional /) is accepted.
CALLE_BASE_URL=

GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# CLI capture only. Exact ASCII E.164; no formatting or whitespace.
# Also requires npm run call:capture -- --consent after recipient agreement.
# The app uses a separate explicit destination-consent step, never resume parsing.
DEMO_PHONE_E164=

# Optional independent 32+ character secret for a trusted webhook relay.
# Relay must send Authorization: Bearer <secret>. Direct unsigned CALL-E events
# are rejected. There is no per-call webhook URL; polling works without a relay.
CLARITY_WEBHOOK_SECRET=
