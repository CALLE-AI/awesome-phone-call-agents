{
  "name": "clarity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "analyze": "node --env-file-if-exists=.env --import tsx scripts/analyze.ts",
    "call:preview": "node --env-file-if-exists=.env --import tsx scripts/capture-call.ts --dry",
    "call:capture": "node --env-file-if-exists=.env --import tsx scripts/capture-call.ts",
    "call:inspect": "node --env-file-if-exists=.env --import tsx scripts/inspect-call.ts",
    "replay:promote": "node --import tsx scripts/promote-run.ts",
    "call:reconcile": "node --env-file-if-exists=.env --import tsx scripts/reconcile-call.ts"
  },
  "dependencies": {
    "@call-e/calle": "^0.7.0",
    "@google/genai": "^2.19.0",
    "libphonenumber-js": "^1.13.12",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "description": "Clarify ambiguous job application claims through one short adaptive phone call.",
  "engines": {
    "node": ">=22.9.0"
  }
}
