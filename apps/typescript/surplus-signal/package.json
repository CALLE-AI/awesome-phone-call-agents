{
  "name": "calle-surplus-signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consent-first surplus food pickup confirmation with a human-reviewed dispatch manifest.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx demo/run-local.ts",
    "surplus-signal": "node --import tsx src/cli.ts",
    "preview": "node --import tsx src/cli.ts preview --request examples/drive.example.json",
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "tsc --noEmit -p tsconfig.ui.json && vite build --config vite.config.ts"
  },
  "dependencies": {
    "@call-e/calle": "0.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
