# --- CALL-E ---
# Get these from your CALL-E beta onboarding (see docs.heycall-e.com/#/sdks)
CALLE_API_KEY=your_calle_api_key_here
CALLE_BASE_URL=https://api.heycall-e.com

# Safety default: TRUE means no real phone calls are placed — dispatch just
# logs what it would have done and marks the job completed immediately.
# Set to "false" only when you're ready to place real, live calls and have
# a valid CALLE_API_KEY configured above.
CALLE_DRY_RUN=true

# --- VendorDesk server ---
PORT=3001

# Public URL CALL-E should hit with terminal call results.
# In local dev, point this at your ngrok/localtunnel URL, e.g.
# https://abcd1234.ngrok-free.app/api/calle-webhook
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3001

# Default region/locale, kept on VendorTask for future display/filtering use.
# Note: CALL-E's POST /v1/calls has no `recipient` field — the phone number
# is embedded directly in the task prompt instead (see src/calle/agentPrompt.ts).
DEFAULT_RECIPIENT_REGION=US
DEFAULT_RECIPIENT_LOCALE=en-US
