# Safe default: fake transport, no phone call, no credentials required.
CALL_MODE=fake
CALLE_LIVE_ENABLED=false
PORT=4174

# Controlled live mode (uncomment and set only for an explicitly approved test call).
# CALL_MODE=live
# CALLE_LIVE_ENABLED=true
# CALLE_API_KEY=<server-side CALL-E API key>
# CALLE_BASE_URL=https://api.heycall-e.com
# CALLE_TEST_RECIPIENT_E164=<consenting test number in E.164>
# CALLE_LIVE_WINDOW_START=<current ISO-8601 timestamp with offset>
# CALLE_LIVE_WINDOW_END=<ISO-8601 timestamp no more than four hours later>
# REVISIT_ZERO_LIVE_OPERATOR_ID=<server-authorized operator identifier>
# REVISIT_ZERO_LIVE_DISPATCH_TOKEN=<random secret with at least 32 characters>
