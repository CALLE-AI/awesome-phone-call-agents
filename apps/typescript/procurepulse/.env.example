# Only needed for `check` and the live `start`/`hold` commands. Preview, replay and demo need nothing.
CALLE_API_KEY=
# Comma-separated E.164 numbers that may be dialed. Empty means nothing can be dialed.
PROCUREPULSE_DIAL_ALLOWLIST=
# Public HTTPS origin for CALL-E terminal webhooks (optional). Without it, results are polled.
PUBLIC_BASE_URL=
