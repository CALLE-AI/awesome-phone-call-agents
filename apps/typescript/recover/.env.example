# CALL-E API key -- get from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# Stripe TEST MODE secret key -- get from https://dashboard.stripe.com/test/apikeys
# Starts with sk_test_... Never use a live key here.
STRIPE_SECRET_KEY=

# Publicly reachable base URL for this app, so CALL-E can deliver the
# terminal call webhook to /api/calle/webhook. For local dev, run a tunnel:
#   npx ngrok http 3000
# and paste the https URL it gives you here, e.g. https://abcd1234.ngrok-free.app
APP_BASE_URL=

# Optional. Delay in minutes before an automatic follow-up call (after a
# no_answer outcome) becomes eligible for preview. Defaults to 1440 (24h)
# if unset, matching realistic dunning cadences. Set this to something small
# like 1 for fast local demo/testing of the follow-up flow.
FOLLOWUP_DELAY_MINUTES=
