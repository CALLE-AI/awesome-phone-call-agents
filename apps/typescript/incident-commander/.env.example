# CALL-E (required to place calls)
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# On-call phones in E.164
ONCALL_PHONE=
ESCALATE_PHONE=
ONCALL_REGION=IN
ONCALL_LOCALE=en-US

# Public HTTPS origin so CALL-E can POST /calle/webhook (ngrok / Cloudflare tunnel)
PUBLIC_BASE_URL=

PORT=8787

# AWS — default credential chain (env, shared config, instance role)
AWS_REGION=ap-southeast-1
ECS_CLUSTER=
ECS_SERVICE=
CW_ALARM_NAME=
ALB_TARGET_GROUP_ARN=
ECS_SECURITY_GROUP_ID=
ECS_LOG_GROUP=

# Poll CloudWatch for ALARM state on CW_ALARM_NAME
ENABLE_ALARM_POLLER=true

# Spoken confirmation still required. Set false to describe-only (no UpdateService).
ALLOW_AWS_WRITES=true
MAX_DESIRED_COUNT=20
