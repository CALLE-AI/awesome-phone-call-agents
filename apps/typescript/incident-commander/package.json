{
  "name": "incident-commander",
  "version": "1.0.0",
  "private": true,
  "description": "Voice-driven SRE: CloudWatch/ECS incidents page the on-call via CALL-E, then execute allowlisted AWS fixes from a confirmed spoken decision.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-ecs": "^3.700.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.1131.0",
    "@call-e/calle": "^0.7.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
