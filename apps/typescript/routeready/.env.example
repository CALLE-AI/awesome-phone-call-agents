# Copy to .env (git-ignored) and fill in. Never commit .env.
CALLE_API_KEY=

# --- Web app (npm start) ---
# 127.0.0.1 keeps the app on this computer. Use 0.0.0.0 to open the rider
# screen from a phone on the same Wi-Fi; starting a live day still needs the token.
HOST=127.0.0.1
PORT=3000
# Live calls stay off unless this is 1.
ROUTEREADY_LIVE=0
# Stops to call for real, as stop=+E164@REGION[@locale], comma separated.
# Only numbers you own or whose owners agreed. Other stops stay scripted.
# CALL-E currently accepts US, SG and AU destinations for English calls.
LIVE_TARGETS=
LIVE_LANGUAGE=English
# Optional fixed start token; a random one is printed at startup otherwise.
ROUTEREADY_TOKEN=

# --- Smoke test (npm run smoke) ---
# One call to a phone you own, in E.164 form such as +15550100123
SMOKE_PHONE=
SMOKE_REGION=US
# Optional BCP 47 locale hint; leave empty for the platform default
SMOKE_LOCALE=
# Language the agent speaks. Bangladesh (BD) destinations are currently rejected in both English and Bengali.
SMOKE_LANGUAGE=English
# Change this to place another smoke call; the same id never dials twice
SMOKE_ID=
