# App API auth (required for POST /api/reminder). Separate from the CALL-E key.
SCHOOL_COLLECTIONS_API_TOKEN=replace-with-a-long-random-secret

# CALL-E provider key. Used only when live calling is explicitly enabled.
CALLE_API_KEY=

# Fake / no-call is the default. Set to true only for an authorized live run.
CALLE_LIVE_ENABLED=false

# Exact ASCII E.164 destination authorized for this live run (must match the request phone).
CALLE_AUTHORIZED_DESTINATION=

PORT=3001
NODE_ENV=
