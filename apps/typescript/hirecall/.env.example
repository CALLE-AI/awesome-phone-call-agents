# Required for Gemini score and summary after every call, including Judge test.
# Prepare resume also uses this to write CALL-E scripts from a real Excel resume.
# Without this key, Judge test can still dial (fake script is already saved) but there is no Gemini summary.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Required to place a live phone call. Without this key, Call shows an error and does not dial.
# Optional CALLE_BASE_URL defaults to https://api.heycall-e.com
CALLE_API_KEY=
# Optional. Default 7. Gemini scores the screening 0-10. Score >= this mark is Next round.
# HIRECALL_PASS_SCORE=7
