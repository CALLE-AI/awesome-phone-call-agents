# Required. The desk asks for this token before any API can read candidates or place calls.
HIRECALL_OPERATOR_TOKEN=

# Required for Gemini score and summary after every call, including Judge test.
# Prepare resume also uses this to write CALL-E scripts from a real Excel resume.
# Without this key, Judge test can still run a dry-run (fake script is already saved) but there is no Gemini summary.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Live outbound calls are off by default. Call then completes a local dry-run and does not dial.
# Set true only when you intend to place a real CALL-E call, including Judge test.
HIRECALL_LIVE_CALLS=false

# Required to place a live phone call when HIRECALL_LIVE_CALLS=true.
# Optional CALLE_BASE_URL, if set, must be exactly https://api.heycall-e.com (that is also the default).
# Loopback and other hosts are refused so the production key is never sent there.
CALLE_API_KEY=
# Optional. Default 7. Gemini scores the screening 0-10. Score >= this mark is Next round.
# HIRECALL_PASS_SCORE=7
