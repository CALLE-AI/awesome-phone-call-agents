# Required only for real calls. The default demo runs with no keys.
# CALLE_API_KEY: from the CALL-E dashboard
CALLE_API_KEY=
# GROQ_API_KEY: from console.groq.com (free), enables plain-English requests
GROQ_API_KEY=

# Optional
# MOCK=false                        # place REAL phone calls (default is mock, no calls)
# TEST_PHONES=+1**********,+1**********   # with MOCK=false, call your OWN numbers instead of real shops
