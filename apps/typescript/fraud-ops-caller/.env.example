# Demo needs no CALL-E keys. Live needs all three plus OPS_RUN_SECRET
# and the desk confirm phrase "I understand this places a real phone call".
# The phrase is not access control — /api/calls/* requires OPS_RUN_SECRET
# (Bearer, x-ops-run-secret, or unlock cookie).
# Do not commit real credentials.
OPS_RUN_SECRET=
CALLE_API_KEY=
# HTTPS production origin only. Localhost and other hosts are rejected.
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_LIVE_CALLS_ENABLED=false
# Optional extra restriction on top of the case's approved phone_e164.
# LIVE_DIAL_ALLOWLIST=+12125550101,+12125550102
