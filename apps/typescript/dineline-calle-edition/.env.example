# Server-side only. Never expose this value in a browser bundle.
CALLE_API_KEY=

# Fixture mode is the default. Set to real only for an explicitly authorized call.
DINELINE_CALL_MODE=fixture

# Real calls remain blocked unless this second switch is also set deliberately.
DINELINE_ALLOW_REAL_CALLS=false

# Comma-separated E.164 destinations that Agent Jake may call in real mode.
DINELINE_ALLOWED_BOOKING_PHONES=

# Agent 1 has its own gate. Arming Agent Jake does not arm a call to the diner.
DINELINE_ALLOW_REAL_INTAKE_CALLS=false

# Comma-separated E.164 destinations that Agent 1 may call in real mode.
DINELINE_ALLOWED_INTAKE_PHONES=
