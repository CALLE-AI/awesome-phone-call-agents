{
  "name": "dineline-calle-edition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded CALL-E booking closure loop for DineLine V2.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:n8n": "node scripts/generate-n8n-workflows.mjs",
    "check": "npm run typecheck && npm test",
    "demo:fixture": "npm run build && node --env-file-if-exists=.env.local dist/src/demo.js",
    "ui": "npm run build && node --env-file-if-exists=.env.local dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@call-e/calle": "0.7.0",
    "@types/node": "26.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
