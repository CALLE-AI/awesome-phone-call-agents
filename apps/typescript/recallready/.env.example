# CALL-E credentials stay server-side. Never put them in browser code or commits.
CALL_E_API_KEY=

# Live outbound calls are fail-closed unless this is exactly true.
LIVE_CALLS_ENABLED=false

# Durable hash-only checkpoint. It stores no phone number, task text, or transcript.
CALL_CHECKPOINT_PATH=data/call-checkpoints.json

# Optional. Defaults to 8788.
PORT=8788
