# CALL-E API — get a key from the CALL-E dashboard (iams_live_...)
CALLE_API_KEY=
# Production API. Test environment: https://test-api.heycall-e.com
CALLE_BASE_URL=https://api.heycall-e.com

# Postgres (asyncpg DSN)
DATABASE_URL=postgresql://user:password@localhost:5432/bb_dispatch

# Operator password for the web UI. The app refuses to run open: without
# this, mutating and result routes return 503.
APP_PASSWORD=
# Comma-separated E.164 numbers that live mode (DRY_RUN=0) may dial as ad
# hoc targets. Registry banks are always authorized; dry-run needs no list.
ALLOWED_DESTINATIONS=

# Optional tuning (defaults shown)
# No-call mode: simulate the four mock-line personas without placing calls.
# Default is 1 (safe by default). Set to 0 to place real CALL-E calls.
DRY_RUN=1
# Max simultaneous CALL-E calls in one run. Confirm your account's
# concurrency cap before raising this.
CALLE_CONCURRENCY=2
# Hard cap on targets per run (each target is a paid call)
MAX_TARGETS=8
# POST /runs rate limit per client IP: N runs per 10 minutes
RATE_LIMIT_RUNS=6
# Per-call wait budget in seconds
CALLE_CALL_TIMEOUT=600

# VAPI private key, used only by scripts/create_vapi_lines.py (mock demo lines)
# VAPI_API_KEY=
