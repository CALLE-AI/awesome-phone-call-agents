# Copy to .env and fill in for live mode. Leave DRY_RUN=true (the default
# when unset) to run everything against deterministic fixtures with no
# credentials and no network calls.

DRY_RUN=true

# Sandbox/test-mode keys only. Never commit real values -- .env is
# git-ignored; only this .env.example (placeholders) is tracked.
DUFFEL_API_KEY=duffel_test_your_key_here
CALLE_API_KEY=calle_test_your_key_here
