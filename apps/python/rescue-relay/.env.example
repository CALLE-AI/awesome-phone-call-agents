# One source of truth for calling behavior. Restart after editing.
CALL_MODE=mock
ENABLE_LIVE_CALLS=false
CALLE_API_KEY=

# Runtime: use ONE worker. Live APIs intentionally require localhost.
HOST=127.0.0.1
PORT=8000
APP_ENV=local
# Production fails closed unless both values are set. Keep them in environment
# configuration or an ignored local .env, never in Git or browser code.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
DATABASE_PATH=./data/rescue_relay.db
MAX_CONTACTS_PER_RUN=12
# Unqualified amounts use this currency; the UI flags that assumption.
DEFAULT_CURRENCY=USD
MOCK_DELAY_SECONDS=1.1
CALLE_POLL_INTERVAL_SECONDS=3
CALLE_TIMEOUT_SECONDS=240

# The official OpenAI origin is pre-approved. For another reviewed provider,
# list its exact HTTPS origin (scheme + hostname + optional port) here.
# Remote base paths must end in /v1; redirects are disabled.
LLM_ALLOWED_ORIGINS=
# A loopback /v1 endpoint is allowed for local development; environment API
# credentials are never attached to loopback requests.
# Blank values run the conservative backup, never pretend to be AI inference.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Set false for operational use when limited rule-based fallback is not acceptable.
LLM_FALLBACK=true
LLM_TIMEOUT_SECONDS=60
LLM_JSON_MODE=true

# Local example (replace the model name with one actually installed):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-installed-model-name
# LLM_API_KEY=
# Another compatible local server might use http://127.0.0.1:1234/v1
# Hosted compatible example: approve https://model.example above, then use
# LLM_BASE_URL=https://model.example/api/v1 plus its model and key.
# LLM_JSON_MODE=false is available for servers that do not accept response_format.
# LLM_FALLBACK=false pauses on absent/failed/invalid model output instead.

# To make real calls: CALL_MODE=live and ENABLE_LIVE_CALLS=true, plus your key.
# There is NO operator token and NO authorized-number environment list.
# Approved saved contacts are the only destination source.
