# Copy to .env. Only live mode reads these; preview and fixture mode need neither.
# Get a key at https://dashboard.heycall-e.com/account/api-keys

CALLE_API_KEY=

# The key is only ever sent to https://api.heycall-e.com. Any other origin is
# refused, except a loopback address while running in fixture mode.
TRUNKLINE_BASE_URL=https://api.heycall-e.com

# Optional. When set, CALL-E also delivers the terminal result to this URL.
# apps/python/webhook-result-receiver is a working receiver.
TRUNKLINE_WEBHOOK_URL=
