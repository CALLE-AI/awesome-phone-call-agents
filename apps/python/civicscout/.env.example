# Environment Configuration Example for CivicScout

# App Settings
APP_NAME=CivicScout
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0

# Google Cloud & Firestore Settings
GCP_PROJECT_ID=civicscout-hackathon
FIRESTORE_DATABASE=(default)
FIRESTORE_USE_MOCK=true

# CALL-E API & SDK
CALLE_API_KEY=your-calle-api-key-here
CALLE_API_BASE_URL=https://api.heycall-e.com/v1
WEBHOOK_BASE_URL=https://your-cloud-run-url.a.run.app
DEFAULT_CALLER_ID=+18005553110

# FastMCP
MCP_SERVER_NAME=CivicScout-Municipal-Tools
