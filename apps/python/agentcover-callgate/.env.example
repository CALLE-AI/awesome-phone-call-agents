# Copy to .env and fill in. CALLE_API_KEY is required ONLY for live calls.
# Without it (or with --dry-run / demo), the app runs fully offline via a
# MockTransport under the real calle-ai SDK — no network, no real call placed.

# Your CALL-E account API key (https://api.heycall-e.com or the console).
CALLE_API_KEY=

# Optional: override the CALL-E API base URL.
# CALLE_BASE_URL=https://api.heycall-e.com

# Owner this agent is bound to (the accountable human).
AGENTCOVER_OWNER=michael

# Autonomy budget ceiling in $ units (one outbound call ~ 1.0).
AGENTCOVER_BUDGET=5000
