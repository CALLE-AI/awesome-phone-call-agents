# From https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# Shown to the customer on the call
STORE_NAME=Nokshi Home
STORE_CURRENCY=BDT

# How many times to ring an order before handing it to a human
MAX_CALL_ATTEMPTS=2
CALL_TIMEOUT_SECONDS=300

# Live demo: dial one handset you control instead of the numbers on the
# orders. An answer from a redirected number is advisory and confirms
# nothing, because whoever answered is not the customer the order belongs to.
DEMO_PHONE=

# Comma separated E.164 numbers this run may dial. Empty means no
# restriction, which is what a real shop wants. Set it while testing so a
# stray row in the order book cannot put a call through to a stranger.
CALL_ALLOWLIST=
