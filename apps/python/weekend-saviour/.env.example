# ==============================================================================
# Weekend Saviour Environment Variables & Configuration Setup
# ==============================================================================

# Call-E Voice AI API Configuration
CALLE_BASE_URL="https://api.heycall-e.com"
CALLE_API_KEY=your_calle_api_key_here

# Google Gemini API Configuration (used by LangGraph StateGraph engine)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Flask Webhook Server & Airflow Pipeline Settings
PORT=7071
FLASK_WEBHOOK_URL=http://localhost:7071/api/airflow-failure-webhook
AIRFLOW_BASE_URL=http://localhost:8080

# Atlassian Jira API Configuration (Optional - fallback data used if omitted)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=engineer@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=DIM


# Atlassian Confluence API Configuration (Optional - local fallback used if omitted)
CONFLUENCE_PLAYBOOK_URL=https://your-domain.atlassian.net/wiki/rest/api/content/123456
CONFLUENCE_CALENDAR_URL=https://your-domain.atlassian.net/wiki/rest/calendar/1.0/events.json
CONFLUENCE_USER_EMAIL=engineer@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
