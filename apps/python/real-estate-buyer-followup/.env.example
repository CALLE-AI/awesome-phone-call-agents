# App-only configuration. Replay performs no network requests.
ESTATE_DB=var/estate.sqlite3
ESTATE_ANALYSIS_MODE=doubao
# Set true when the project owner authorizes sending real call transcripts and
# CALL-E results to Doubao for feedback, preference and CRM suggestion analysis.
ESTATE_DOUBAO_ANALYSIS_AUTHORIZED=false
# Optional real Doubao planning/extraction; phone mode remains separate.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
# Web defaults to Mock. Choosing live in the UI enables the SDK path for that
# task; approval and a separate execute click are still required. Key stays local.
CALLE_API_KEY=
# Programmatic Workflow opt-in and optional destination defaults (not needed
# when a Web user enters a destination on the preparation page).
ESTATE_ENABLE_LIVE=false
ESTATE_LIVE_PHONE=
ESTATE_LIVE_LOCALE=
