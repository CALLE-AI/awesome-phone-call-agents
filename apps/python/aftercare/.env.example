APP_ENV=local
# local | test | staging | production
# Local (outside Docker): use localhost. Docker Compose overrides this to host `db`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/post_discharge_follow_up
DRY_RUN_DEFAULT=true
# How often the background scheduler looks for due follow-ups and places calls.
SCHEDULER_INTERVAL_MINUTES=1

# Worker controls (default: on except when APP_ENV=test)
# ENABLE_SCHEDULER=true
# ENABLE_EMBEDDING_BACKFILL=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host header allow-list (* = any). Required real hosts in staging/production.
TRUSTED_HOSTS=*
# api.example.com,www.example.com

# Force HTTPS redirect + HSTS. Default: on in staging/production, off locally.
# Set false if a reverse proxy already terminates TLS and speaks HTTP to the app.
# FORCE_HTTPS=false

LOG_LEVEL=INFO

# Windows local dev only: if Gemini/HTTPS calls fail with CERTIFICATE_VERIFY_FAILED,
# set before starting uvicorn (PowerShell):
# $env:SSL_CERT_FILE = (.\.venv\Scripts\python.exe -m certifi)

# Connection pool (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# JWT auth (required). Use a long random secret in staging/production (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-secret-32b+
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14


REGISTER_SECRET=change-me-register-secret

# Developer API key from https://dashboard.heycall-e.com/account/api-keys
# Sent only to https://api.heycall-e.com. Do not commit a real key.
CALLE_API_KEY=

# Official HTTPS origin only. Any other CALLE_BASE_URL is refused.
CALLE_BASE_URL=https://api.heycall-e.com

# Reserved fictional E.164 for local demos (not a real line).
CALLE_EXAMPLE_PHONE=+15555550100

# Optional. When unset, /webhooks/calle accepts unsigned JSON.
# CALLE_WEBHOOK_SECRET=whsec_...

# Public HTTPS URL CALL-E will POST terminal call events to.
# Local: ngrok http 8000 → https://xxxx.ngrok-free.app/webhooks/calle
# Required (HTTPS) in staging/production.
# CALLE_WEBHOOK_URL=https://xxxx.ngrok-free.app/webhooks/calle

# Claude / Anthropic — primary for transcript extraction and admin agent
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_ENABLED=true

# Embeddings run locally with sentence-transformers/all-MiniLM-L6-v2.
# No embedding API key is required.

# Google Gemini — fallback if Claude is unset or fails
GOOGLE_API_KEY=
AGENT_MODEL=gemini-flash-latest
AGENT_ENABLED=true
