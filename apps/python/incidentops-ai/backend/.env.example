# IncidentOps AI - Safe Demo defaults

# Gemini is optional.
# Leave blank to use deterministic fallback analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Backward compatibility
OPENAI_API_KEY=NOT_USED
LLM_MODEL=gemini-3.5-flash

# CALL-E live configuration.
# Leave blank for credential-free Safe Demo operation.
CALLE_API_KEY=
CALLE_LANGUAGE=English

# Server-controlled authorized live destination.
ONCALL_PHONE=

# Safe defaults: no real phone calls.
CALLE_LIVE_CALLS_ENABLED=false
CALLE_MAX_LIVE_CALLS_PER_PROCESS=1
CALLE_CALL_COOLDOWN_SECONDS=60
SAFE_DEMO_MODE=true

# Required only for POST /incident/escalate.
# Leave blank to disable remote live escalation.
INCIDENTOPS_API_TOKEN=
