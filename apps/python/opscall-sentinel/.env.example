# CALL-E API Credentials
# Get your API key from https://dashboard.heycall-e.com/ -> API keys
CALLE_API_KEY=your_calle_api_key_here

# Telephony Mode: 'live' (makes real phone calls) or 'mock' (offline test fixture, 0 credits used)
CALLE_MODE=mock

# Target On-Call Engineer Phone Number in E.164 format (e.g. +15555550100)
PRIMARY_ONCALL_PHONE=+15555550100
SECONDARY_ONCALL_PHONE=+15555550101

# Verification PIN required by the on-call engineer during call
ONCALL_SECURITY_PIN=4829

# Web Dashboard Server Port
PORT=8000
HOST=127.0.0.1
