# Copy this file to .env and replace every required placeholder.
# .env is ignored by Git. Never commit real credentials, tokens, or phone data.
# Exported environment variables take precedence over values in .env.

# Salesforce OAuth client-credentials settings (required for every run).
# Use the My Domain host only; do not append /services/oauth2/token.
SALESFORCE_DOMAIN=https://your-domain.my.salesforce.com
# Consumer Key and Consumer Secret from the Salesforce External Client App.
SALESFORCE_CLIENT_ID=replace-with-salesforce-consumer-key
SALESFORCE_CLIENT_SECRET=replace-with-salesforce-consumer-secret
# Use a supported REST API version; this project metadata targets v66.0. Verify
# the version supported by the Salesforce org before deploying.
SALESFORCE_API_VERSION=v66.0

# Runtime External Client App settings. Create a dedicated QuoteWake External
# Client App and configure its Run As user to the Salesforce user assigned the
# QuoteWake_User permission set. Keep the consumer key and secret in a secret
# manager; these placeholders are safe to copy but must never be committed with
# real values.

# Required only for Salesforce orgs where Quote.CurrencyIsoCode is unavailable
# because multiple currencies are disabled.
SALESFORCE_CURRENCY_CODE=EUR

# Optional Salesforce Contact checkbox used for opt-out filtering.
# Leave empty when the org has no custom opt-out field.
SALESFORCE_DO_NOT_CALL_FIELD=

# Quote statuses that the runtime is allowed to follow up.
QUOTEWAKE_ALLOWED_QUOTE_STATUSES=Presented

# CALL-E settings. CALLE_API_KEY is required only with --execute.
CALLE_API_KEY=replace-with-calle-api-key
CALLE_BASE_URL=https://api.heycall-e.com
