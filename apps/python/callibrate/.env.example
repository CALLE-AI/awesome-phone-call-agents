# Callibrate configuration. Everything is CBR_-prefixed.
# Copy to .env. Nothing here is a secret in this form.

CBR_ENVIRONMENT=development
CBR_DATABASE_PATH=data/callibrate.db
CBR_HOST=127.0.0.1
CBR_PORT=8000

# The default caller replays scripted conversations and dials nothing.
# Set to calle to place real phone calls through CALL-E.
CBR_CALLER_MODE=pilot

# The only numbers this deployment may ever ring. Empty means none, which is
# why a fresh install cannot call anybody by accident.
CBR_CALL_ALLOWLIST=

# The number the seeded demonstration provider answers on. Set this to a line
# you control before turning on live calling.
CBR_DEMO_PROVIDER_PHONE=
CBR_DEMO_PROVIDER_REGION=US
CBR_DEMO_PROVIDER_TIMEZONE=America/New_York

# Left empty, the token cached by `calle auth login` is used.
CBR_CALLE_ACCESS_TOKEN=

CBR_CURATOR_USERNAME=judge
CBR_CURATOR_PASSWORD=callibrate-demo-2026
CBR_SECRET_KEY=development-only-change-me
