# Copy to .env and fill in for a LIVE call. Never commit the real .env file.
# Leave CALLE_DRY_RUN=true for all testing/validation - flip to false only
# for the one real call you record for the demo.
#
# For a live call, also: pip install calle-ai (the official Python SDK -
# calle_client.py falls back to CALL-E's plain REST API if it isn't
# installed, but the SDK is the documented, supported path).

CALLE_DRY_RUN=true
CALLE_API_KEY=
CALLE_API_BASE=https://api.heycall-e.com

# Your own number, used only for disclosed, consented self-testing. Keep this
# out of source control - it belongs in .env / the environment, not in code
# or in the scenario JSON files.
CALLE_RECIPIENT_PHONE=

# Risk threshold an incident's score must meet or exceed to trigger a call.
FORGEGATE_RISK_THRESHOLD=0.7

# Where the audit_log.jsonl file is written.
FORGEGATE_LOG_DIR=./data
