# Copy to a secret location (e.g. .env) and fill with real values.
# The app loads .env files with python-dotenv when present.
# Leave CALL_E_API_KEY empty to stay in fail-closed simulated mode.

CALL_E_API_KEY=
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
FLASK_SECRET=replace-with-a-long-random-value

# Operator-only switches. The app fails closed when these are unset:
#   CALLE_LIVE_CALLS_ENABLED - "1"|"true"|"yes" explicitly enables live calls;
#     requires APP_TOKEN (>=16 chars, no whitespace).
#   APP_TOKEN - bearer token every API route requires.
#   PERSIST_GOOGLE_TOKEN - "1"|"true"|"yes" permits writing the OAuth token to
#     disk (user_token.json) and restoring from GOOGLE_TOKEN_JSON.
# Without PERSIST_GOOGLE_TOKEN the OAuth token lives only in server memory for
# the session that authorized it.
# CALLE_LIVE_CALLS_ENABLED=1
# APP_TOKEN=replace-with-a-long-random-value
# PERSIST_GOOGLE_TOKEN=1

# Optional overrides
# GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
# GOOGLE_REDIRECT_URI_LOCAL=http://localhost:8080/oauth2callback
# PORT=8080