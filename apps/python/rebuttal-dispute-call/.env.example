# From the CALL-E dashboard. Only the live command reads it.
CALLE_API_KEY=

# The key is sent only to https://api.heycall-e.com or https://test-api.heycall-e.com.
CALLE_BASE_URL=https://api.heycall-e.com

# Comma-separated E.164 numbers a live run may call. Empty means no live call can be placed.
REBUTTAL_CALL_ALLOWLIST=

# Spoken in the disclosure that opens the call.
MERCHANT_NAME=
