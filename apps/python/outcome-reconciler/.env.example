# Copy to .env and fill in. `.env` is gitignored; never commit a real key.
#
# Nothing loads this file automatically — no app in this repository does. Load
# it into your shell before running:
#
#   set -a && source .env && set +a
#
# Server-side secret from https://dashboard.heycall-e.com/account/api-keys.
# Used by the rest.calls and rest.goal_runs surfaces. The mcp.get_call_run
# surface does NOT use this: it reuses the token cache from `calle auth login`.
CALLE_API_KEY=your_api_key_here

# Optional. Defaults to https://api.heycall-e.com. The key is only ever sent
# there or to loopback; any other host is refused before the key is read.
# CALLE_BASE_URL=https://api.heycall-e.com