# Server-side secret from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=<replace-me>

# Replace only for an approved test endpoint. Production default:
CALLE_BASE_URL=https://api.heycall-e.com

# Live calls remain locked unless this is explicitly true.
CALLE_LIVE_CALLS_ENABLED=false
CALLE_TIMEOUT_SECONDS=600

# Local web MVP settings.
FRESHCHAIN_HOST=127.0.0.1
FRESHCHAIN_PORT=8080
FRESHCHAIN_DB_PATH=./data/freshchain.sqlite3
# Required when live calls are enabled; use at least 32 random non-space characters.
FRESHCHAIN_LIVE_TOKEN=<replace-with-32-or-more-random-characters>
LOG_LEVEL=INFO
