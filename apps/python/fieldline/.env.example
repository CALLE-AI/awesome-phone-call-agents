# ---- CALL-E credentials (live mode) ----------------------------------
# Create an account at https://www.heycall-e.com/ (20 free calls),
# then create a key at https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# Only the official secure origin is accepted; do not override it.
# CALLE_BASE_URL=https://api.heycall-e.com

# ---- FieldLine switches ----------------------------------------------
# Demo is the default even with a key. Set false explicitly for live commands.
FIELDLINE_DEMO=true

# 1 = skip demo pacing delays (used by tests/CI).
FIELDLINE_FAST=
