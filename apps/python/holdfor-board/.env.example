# Copy to `.env`, which is gitignored. `python -m holdfor <command>` reads that file at
# startup, so a setting only has to be written once rather than sourced before every
# launch. Anything already in the environment wins, so a variable typed on the command
# line is never overridden by this file.
#
# FakeProvider is the default and needs nothing set. Live calls are opt-in.
#
# CALLE_LIVE=1 is the only switch that makes a real phone call possible, and it is the
# one setting `.env` cannot supply: it is skipped by name when the file is read. Config
# comes from a file; spending one of the twenty is typed on the command line, every
# time. Every number dialled must belong to someone on the team.
#
#   CALLE_LIVE=1 uv run python -m holdfor call 2
#
# Numbers below are Ofcom-reserved fictional ones. Real handsets go in `.env` and
# nowhere else — never here, this file is tracked.

HOLDFOR_DB=holdfor.db

# The practice's appointments line, which a Rebooking Call dials. No default, on
# purpose: a wrong one here rings a real surgery, so an absent one refuses the call
# with `no_booking_line` instead.
# HOLDFOR_BOOKING_LINE=+441632960118

# The handset at the board, so a row can be seen to be aimed at a phone in the room
# before anybody presses Run. Compared and then discarded: only a mask reaches the page.
# HOLDFOR_MY_HANDSET=+441632960119

# The second pass that reads the four answers out of a transcript. `calle call start`
# cannot carry a result schema, so a live call comes back as words and a status and the
# board's three bounded fields stay empty. Set this and the board reads them itself,
# through the same validation the call's own answers would have faced. Absent means the
# board behaves as it did before: extraction_failed, and a person reads the call.
#
# What leaves the machine is the conversation — a first name and how somebody says they
# have been. Never a surname, a date of birth or a number: the agent promises aloud not
# to ask for those.
# ANTHROPIC_API_KEY=sk-ant-...
# HOLDFOR_EXTRACT_MODEL=claude-sonnet-5
# HOLDFOR_EXTRACT=0            # keep the key, switch the second pass off

# What time the app believes it is. NOT an override of the Reading Window: the rule
# stays 10:00 to 16:00 on a weekday, and 16:00 exists because a flagged Review Item
# after it sits unread overnight. This is the clock that rule is applied to — the same
# lever the test suite uses, and previously reachable from nowhere else.
#
# For testing outside those hours. A bare HH:MM means that time today, which moves the
# hour without touching the day; the due list is judged against this clock too, so a
# whole date silently changes which Appointments come due. Everything that reads it
# says so out loud: the board carries a banner and the CLI prints a line.
# HOLDFOR_NOW=11:00
