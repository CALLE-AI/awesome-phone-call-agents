# FakeProvider is the default and needs nothing set. Live calls are opt-in.
#
# CALLE_LIVE=1 is the only switch that makes a real phone call possible. Absent by
# default, on purpose: leave it unset unless you mean to spend one of the twenty.
# Every number dialled must belong to someone on the team.
# CALLE_LIVE=1

HOLDFOR_DB=holdfor.db

# The second pass that reads the four answers out of a transcript. `calle call start`
# cannot carry a result schema, so a live call comes back as words and a status and the
# board's three bounded fields stay empty. Set this and the board reads them itself,
# through the same validation the call's own answers would have faced. Absent means the
# board behaves as it did before: extraction_failed, and a person reads the call.
#
# What leaves the machine is the conversation — a first name and how somebody says they
# have been. Never a surname, a date of birth or a number: the agent promises aloud not
# to ask for those.
# ANTHROPIC_API_KEY=sk-ant-...
# HOLDFOR_EXTRACT_MODEL=claude-sonnet-5
# HOLDFOR_EXTRACT=0            # keep the key, switch the second pass off
