# Reachable configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# This file documents every variable and contains NO real values.
#
# Reachable places no calls at all unless REACHABLE_LIVE_CALLS=1 *and* a human
# confirms each individual call. See docs/SAFETY.md.

# ---------------------------------------------------------------- credentials

# CALL-E bearer token. Server-side only; never logged, rendered or exported.
# Needed only to place live calls. The fake server and every test run without it.
CALLE_API_KEY=

# Single admin token for the dashboard. Any non-empty value enables the check.
REACHABLE_ADMIN_TOKEN=

# ------------------------------------------------------------ safety switches

# Set to exactly 1 to allow live calls. Anything else, including "true" and "0",
# means off. This is necessary and NOT sufficient: every call also needs a typed
# confirmation in the CLI or the confirm step in the dashboard.
REACHABLE_LIVE_CALLS=

# --------------------------------------------------------------- call routing

# The ONLY permitted values are https://api.heycall-e.com or a loopback address
# for the local fake server (for example http://127.0.0.1:8787). Anything else is
# refused at startup, before the API key is read, so a misconfigured value cannot
# leak a bearer token. Leave blank for the official origin.
REACHABLE_CALLE_BASE_URL=

# Client timeout in seconds. Set well above provider acceptance latency on
# purpose: a short timeout tells you about your client, not about the telephone.
REACHABLE_CALLE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ behaviour

# Consecutive unexplained (code N) register sessions that fire a follow-up.
REACHABLE_TRIGGER_SESSIONS=2

# Attempts per contact, and contacts tried per pupil per trigger.
REACHABLE_MAX_ATTEMPTS=2
REACHABLE_CASCADE_LIMIT=4

# Minimum CALL-E completion_confidence.score to treat a result as usable.
# Configurable because CALL-E publishes no threshold. The label is checked too.
REACHABLE_CONFIDENCE_FLOOR=0.6

# Days to keep sanitised transcripts. Short by default; the outcome survives.
REACHABLE_TRANSCRIPT_RETENTION_DAYS=14

# Identifies the current term, used in the contact-check idempotency key.
REACHABLE_TERM_ID=

# ------------------------------------------------------------ data and storage

# Directory holding pupils.csv, contacts.csv, register.csv, school_calendar.csv
# and school.csv.
REACHABLE_DATA_DIR=sample_data

# SQLite path. The default lives under data/ and is gitignored.
REACHABLE_DB=data/reachable.sqlite3

# NOTE: the school name, IANA timezone and calling window are NOT set here.
# They come from school.csv, because they are properties of the school rather
# than of this deployment.
