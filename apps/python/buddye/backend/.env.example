# ---- BuddyE backend -------------------------------------------------------
# Defaults fail closed: mock provider, empty allowlist, tiny budget.

# mock | calle_sdk | calle_mcp
CALL_PROVIDER=mock

# Real-call guard rails (apply to calle_sdk and calle_mcp only; there is no switch that disables them)
CALL_BUDGET_MAX=4
# Comma-separated strict ASCII E.164 numbers (+15550100 style) a real provider may dial. Empty = nobody.
# A malformed entry stops startup.
DIALABLE_NUMBERS=
# Numbers injected into the seeded demo neighbours (A = Rosa Delgado, B = Walter Brzezinski,
# C = Ernesto Salgado). They must ALSO be in DIALABLE_NUMBERS or the sweep skips them.
DEMO_PHONE_A=
DEMO_PHONE_B=
DEMO_PHONE_C=

# CALL-E Developer API (calle_sdk). Key from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# Random path token for the terminal webhook receiver. Auto-generated per process if empty;
# set it explicitly in production so restarts keep the same webhook URL.
CALLE_WEBHOOK_SECRET=
# Public origin of this backend (tunnel or deployment). webhook_url is only sent when set.
PUBLIC_BASE_URL=

# CALL-E CLI (calle_mcp): path to the `calle` binary, already authenticated via `calle auth login`.
CALLE_CLI_BIN=calle

# Optional LLM reconcile step for ambiguous results. Leave empty to keep unknowns unknown.
# --- Inference layer (the reconcile / transcript-understanding step) ---
# RECONCILER: auto = use whichever key is set, TokenRouter first. none = never call a model.
RECONCILER=auto
# TokenRouter is an OpenAI-compatible gateway: https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
RECONCILE_MODEL=z-ai/glm-5.3-flash
# The free tier measured ~50-70 s for one transcript pass; leave headroom.
RECONCILE_TIMEOUT_S=90

# Alternative inference provider. Only used when TOKENROUTER_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_RECONCILE_MODEL=claude-opus-5
# Operator layer
# The name that appears on generated paperwork. It can never authorise anything.
OVERSEER_NAME=
# Community resources are committed with no click; agency units stay PROPOSED either way.
AUTO_DISPATCH=true
INCIDENT_SYNC_S=2.0
MOVEMENT_TICK_S=2.0
BLOCK_CAPTAIN_NAME=Alma Reyes

# Pacing
STEP_DELAY_S=0.6
MOCK_DELAY_S=1.2
DATABASE_URL=sqlite:///./buddye.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
