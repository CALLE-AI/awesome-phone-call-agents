          "field_type": "boolean"
        },
        {
          "id": "H2",
          "name": "Urgency/threat escalation when questioned",
          "examples": ["your account will be suspended today", "final notice", "legal action will be taken"],
          "result_field": "used_urgency_or_threat_language",
          "field_type": "boolean"
        },
        {
          "id": "H3",
          "name": "Refuses or hedges on company name/department",
          "examples": [],
          "result_field": "refused_to_state_company_name",
          "field_type": "boolean"
        },
        {
          "id": "H4",
          "name": "Cannot provide callback number matching published support line",
          "examples": [],
          "result_field": null,
          "note": "Evaluated during prechecks by comparing callback_number_offered / the dialed number against the claimed company's official support number, not self-reported by the call agent."
        }
      ]
    },
    "medium": {
      "weight": 1,
