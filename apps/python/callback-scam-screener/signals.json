{
  "context_fields": [
    {"name": "company_name_stated", "type": ["string", "null"]},
    {"name": "department_stated", "type": ["string", "null"]},
    {"name": "callback_number_offered", "type": ["string", "null"]},
    {"name": "call_summary", "type": "string"}
  ],
  "categories": {
    "critical": {
      "weight": "force_scam",
      "signals": [
        {
          "id": "C1",
          "name": "Requests remote-access software install",
          "examples": ["download AnyDesk", "install TeamViewer", "UltraViewer", "LogMeIn", "take control of your screen"],
          "result_field": "requested_remote_access_software",
          "field_type": "boolean"
        },
        {
          "id": "C2",
          "name": "Requests gift card / crypto / wire payment",
          "examples": ["buy a gift card", "send Bitcoin", "wire transfer the funds"],
          "result_field": "requested_payment_method",
          "field_type": "enum",
          "present_values": ["gift_card", "crypto", "wire", "other"]
        },
        {
          "id": "C3",
          "name": "Requests OTP / MFA code / card PIN or CVV",
          "examples": ["read me the code we texted you", "what's the 3-digit number on the back"],
          "result_field": "requested_otp_or_card_details",
          "field_type": "boolean"
        }
      ]
    },
    "high": {
      "weight": 3,
      "signals": [
        {
          "id": "H1",
