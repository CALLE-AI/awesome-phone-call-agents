# The generated evidence page is build output, not source.
#
# It is deployed as a built artifact rather than built from this repository, because the
# call audio is deliberately not committed and a repository build would quietly publish a
# page whose hero call has no sound. Committing the output would also put a second,
# drifting copy of every number next to the receipts it was generated from.
#
# Regenerate it with: python tools/judge_page.py
out/

__pycache__/
*.pyc
.pytest_cache/

# Gate harness dependencies and its output.
tools/gates/node_modules/
tools/gates/shots/
tools/gates/gate-report*.json

# Generated by tools/make_figure.py at build time. Not committed: a drawing in the tree
# is a drawing somebody exported once, and this one is derived from page.css and rebuilt
# by judge_page.py on every run, so there is nothing for it to drift against.
tools/site/figures/

# Two empty files that appear when a tool is run with this directory as its working
# directory. Nothing in this project writes either one: `grep -rn local_dev.db --include=*.py`
# returns nothing, and both arrived at 0 bytes during an unrelated CLI run. They are ignored
# so they cannot be committed by accident, and named here rather than guessed at.
local_dev.db
profile-claim.lock

# setuptools leaves these beside calle_double/pyproject.toml when the double is built or
# installed with -e. They are build output describing the tree they were built from, so a
# committed one goes stale the moment the version or the dependency list changes.
*.egg-info/
build/
dist/

# Debug screenshots from the browser probes. Scratch, never shipped.
.probe/
