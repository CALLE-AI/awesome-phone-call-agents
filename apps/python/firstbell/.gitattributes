# Committed evidence, not authored source. GitHub collapses these in a pull request diff so a
# reviewer sees the code rather than 100KB of transcript JSON, and they stop skewing the
# language statistics for the whole repository.
evidence/transcripts.json  linguist-generated=true
evidence/provider-ids.json linguist-generated=true
evidence/*.json            linguist-generated=true

# Keep line endings stable across platforms. A receipt whose bytes change on checkout is a
# receipt whose digest cannot be quoted.
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.css  text eol=lf
*.js   text eol=lf
