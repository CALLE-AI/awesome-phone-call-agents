# Orma — local environment. Copy to .env and fill in.
# Supabase project "orma", ref pyuubklpkhjngiqqwypf, region ap-south-1.
#
# Blank values are not yet obtainable and are listed in dev-diary/README.md
# as blockers on their owning task.

# Runtime
ORMA_ENV=development
ORMA_DRY_RUN=true
# Selects which recorded fixture a dry run synthesises. Defaults to completed.
ORMA_DRY_RUN_FIXTURE=completed
ORMA_PUBLIC_URL=https://orma.nryn.dev
ORMA_API_URL=https://orma-api.nryn.dev
ORMA_OWNER_PHONE=+910000000000
ORMA_WEBHOOK_SECRET=

# Supabase
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# T2.1 and T2.4 scheduler key. This is the Supabase secret API key named
# "materialise". Put this value in Vault under the same key name.
ORMA_MATERIALISE_SECRET_KEY=

# CALL-E  (T0.4)
CALLE_API_BASE=https://api.heycall-e.com
CALLE_API_KEY=

# Telegram  (T3.1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Vertex AI
GOOGLE_VERTEX_PROJECT=nryn-personal
GOOGLE_VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GEMINI_MODEL=gemini-3.8-flash

# Email  (T5.1)
RESEND_API_KEY=
RESEND_FROM=orma@example.com

# Cloudflare
# CF_DNS_API_TOKEN is zone-scoped to nryn.dev, read and write DNS.
# It is NOT named CLOUDFLARE_API_TOKEN on purpose: wrangler auto-loads a
# project .env and would prefer that name over your OAuth login, which
# breaks every Pages command with an authentication error.
# Pages auth comes from `wrangler login`, not from a token here.
CF_DNS_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
