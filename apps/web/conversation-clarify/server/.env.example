# Nothing here is needed to run the app. Fixture mode is the default and a
# fresh checkout cannot dial anyone. These are only for live calling.

# Read by the server only. It is never sent to the browser or the extension.
CALLE_API_KEY=iams_live_replace_me

# Live mode refuses to start without its own shared secret, because an
# unauthenticated endpoint that dials real phones is an open relay.
CONVERSATION_CLARIFY_MODE=fixture
CONVERSATION_CLARIFY_TOKEN=generate_with_python_secrets_token_urlsafe_24

# Spoken on the call: "an AI assistant calling on <this name>'s behalf".
CONVERSATION_CLARIFY_USER=Your Name

# Which recorded outcome fixture mode replays.
# resolved | voicemail | no_answer | unresolved | off_menu
CONVERSATION_CLARIFY_FIXTURE=resolved

# Optional model pass. Without these, detection is rules only — deterministic,
# offline, and requiring no key.
DEFAULT_AI_ENV=
GEMINI_API_KEY=
GEMINI_MODEL_NAME=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=
