# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && npm run start:real

# fake (default, no network, no calls) or calle (real, billed outbound calls)
CALL_PROVIDER=calle

# From https://dashboard.heycall-e.com/ — a web dashboard, no CLI install needed.
CALLE_API_KEY=

# Optional, and there is nothing to change: CALLE_API_KEY is only ever sent to
# https://api.heycall-e.com, and any other value here is refused at startup.
# CALLE_BASE_URL=https://api.heycall-e.com

# The number task_1's first supplier is dialled at, in E.164: "+", country code, number,
# no spaces. Use a phone you own — you answer it and play the supplier. Leave unset and
# the seed keeps its fictional +1-555-0100, which the real provider refuses to dial.
DEMO_SUPPLIER_PHONE=

# The only numbers the real provider will dial, comma-separated E.164. Empty means none:
# every live call is refused. Put DEMO_SUPPLIER_PHONE's number here as well — being the
# supplier's number is not authorization by itself. Numbers reserved for fiction (every
# sample in this repo) are refused here and at dial time.
CALLE_ALLOWED_DESTINATIONS=
