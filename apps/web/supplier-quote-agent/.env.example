# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && npm run start:real

# fake (default, no network, no calls) or calle (real, billed outbound calls)
CALL_PROVIDER=calle

# From https://dashboard.heycall-e.com/ — a web dashboard, no CLI install needed.
CALLE_API_KEY=

# Optional. Defaults to CALL-E's documented REST API.
# CALLE_BASE_URL=https://api.heycall-e.com

# The number task_1's first supplier is dialled at, in E.164 (e.g. +6591234567).
# Use a phone you own — you answer it and play the supplier. Leave unset and the
# seed keeps its fictional +1-555-0100, which no real call can reach.
DEMO_SUPPLIER_PHONE=
