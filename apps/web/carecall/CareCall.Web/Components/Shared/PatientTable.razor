@if (Patients.Count == 0)
{
    <p class="empty">No patients to display.</p>
}
else
{
    <div class="directory-grid">
        @foreach (var p in Patients)
        {
            <a @key="p.Id" class="directory-card" href="@($"/patients/{p.Id}")">
                <span class="care-avatar" aria-hidden="true">@Initials(p.Name)</span>
                <div class="contact-details">
                    <h2>@p.Name</h2>
                    <p>@p.Diagnosis</p>
                    <div class="card-badges"><RiskBadge Level="p.RiskLevel" /><StatusBadge Status="p.Status" /></div>
                    <p class="card-note">@(p.NextCall is { } next ? $"Next call: {next.ToLocalTime():dd MMM · HH:mm}" : "No future call scheduled")</p>
                    @if (p.OpenAlerts > 0)
                    {
                        <p class="card-note"><strong>@p.OpenAlerts open alert(s)</strong></p>
                    }
                </div>
            </a>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PatientRow> Patients { get; set; } = [];

    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
