# --- CALL-E safe execution boundary (lib/calle/, server side only) ---
# Fake is the implicit default, including when CALLE_API_KEY is populated.
CALL_MODE=fake
CALLE_LIVE_ENABLED=false
CALLE_API_KEY=
# Live credentials are only sent to this official origin.
CALLE_BASE_URL=https://api.heycall-e.com

# --- Workflow engine (lib/engine-client.ts, server side only) ---
# The standalone FastAPI service in engine/. Defaults to http://localhost:8008 when unset.
ENGINE_URL=
# Required for a remote engine. Comma-separated exact HTTPS origins; localhost loopback
# origins are trusted automatically for development.
ENGINE_ALLOWED_ORIGINS=
# Optional. Only needed if the engine has ENGINE_SHARED_SECRET set — see engine/.env.example.
ENGINE_SHARED_SECRET=

# Example: https://veyra.vercel.app
APP_URL=
# Secret carried only in CALL-E's per-call webhook URL. Use at least 32 random characters,
# for example: openssl rand -hex 32. Required before live mode can launch.
CALLE_WEBHOOK_TOKEN=

# --- Background call dispatch (lib/queue/, scripts/dispatch-worker.ts) ---
# CloudAMQP (or any RabbitMQ) connection string. Launching a campaign queues one job per
# call here instead of placing it in-process; `pnpm worker` must be running (alongside
# `pnpm dev`) to actually consume the queue and place calls, fake or live.
RABBIT_MQ_URL=

# --- Optional scheduled campaign dispatch ---
# Keep false on Vercel Hobby, whose cron jobs run only once per day. On a deployment with
# a frequent scheduler, set true and invoke GET /api/cron/campaigns with the bearer secret.
CAMPAIGN_SCHEDULING_ENABLED=false
# Random value of at least 16 characters. Vercel automatically sends this as the Bearer
# token for configured cron invocations. Example: openssl rand -hex 32
CRON_SECRET=

# --- Supabase ---
# Direct Postgres connection string for Drizzle (lib/db/), NOT the Data API URL above.
# Project Settings -> Database -> Connection string -> URI, "Transaction pooler" mode for
# serverless. Must be the `postgres` role specifically — it is the role Supabase makes a
# member of `authenticated` by default, which is what lib/db/with-rls.ts depends on to
# keep RLS enforced through a direct connection. Never expose this to the browser.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# The browser-side key. Named PUBLISHABLE, not ANON — this is what lib/supabase/*.ts
# actually read, and it is Supabase's current name for the key (legacy `anon` keys still
# work but are kept only for compatibility). Safe to expose: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase settings that are NOT configurable from code ---
# Authentication > Providers > Email > "Confirm email" must be OFF, and supabase/schema.sql
# must have been run in the SQL editor. See TECHNICAL_ARCH.md -> Authentication.
