# --- Gemini API, for workflow generation and NL editing (app/generator.py) ---
GEMINI_API_KEY=
# Optional — leave the value blank (not just unset) and it still falls back to the
# default (gemini-3.6-flash as of writing). Google retires model names over time; if
# generation starts failing with a 404 "model ... is no longer available", the error
# message names the current replacement — put that here.
GEMINI_MODEL=

# --- Optional auth between the Next.js app and this service ---
# When set, every /workflows/* route except /health requires
# `Authorization: Bearer <this value>`. Leave unset for local dev.
ENGINE_SHARED_SECRET=

# Not needed here: CALLE_API_KEY, SUPABASE_* — this service never dispatches calls or
# persists anything. See engine/README.md.
