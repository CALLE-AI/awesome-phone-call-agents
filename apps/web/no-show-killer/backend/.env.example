CALL_E_ACCESS_KEY=

PORT=4000
CRON_SCHEDULE=0 18 * * *
CRON_TIMEZONE=America/Los_Angeles
CRON_ENABLED=true

# Required. The server refuses to start without this set - every route that
# reads appointment data or can trigger a call requires
# `Authorization: Bearer <API_TOKEN>` (or `?token=` on the WebSocket).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=

# Required before any appointment can actually be created or called.
# Comma-separated, E.164 format. Nothing is authorized by default - a
# deliberate secure default, not a bug - so appointment creation and call
# dispatch both reject any number not in this list.
ALLOWED_CALL_NUMBERS=

# Optional. Restricts CORS to this origin (your deployed frontend's URL).
# Leave unset for local dev; set it in production.
ALLOWED_ORIGIN=

# Safety default: the nightly cron never places unattended calls on its own.
# Set to true only if you want it to actually dial without an operator
# clicking "Run tomorrow's confirmation calls" first.
LIVE_UNATTENDED_BATCH=false

# Safety default: no real CALL-E call is placed until you explicitly opt in.
# Leave this as true (or unset) for demos and development. Set to false only
# when you're ready to dial real phone numbers.
DRY_RUN=true
