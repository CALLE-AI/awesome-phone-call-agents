CALL_E_ACCESS_KEY=

PORT=4000
CRON_SCHEDULE=0 18 * * *
CRON_TIMEZONE=America/Los_Angeles
CRON_ENABLED=true

# Safety default: no real CALL-E call is placed until you explicitly opt in.
# Leave this as true (or unset) for demos and development. Set to false only
# when you're ready to dial real phone numbers.
DRY_RUN=true
