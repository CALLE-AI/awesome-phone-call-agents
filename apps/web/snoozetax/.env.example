# CALL-E Developer API
# This file documents the variable names only. Never commit real keys.

CALLE_API_KEY=iams_live_your_key_here
CALLE_BASE_URL=https://api.heycall-e.com

# Safety: when true, no real phone calls are placed and no credits are spent.
# Default is true so the project can be cloned and run without an API key.
DRY_RUN=true

# Public base URL where CALL-E delivers terminal webhooks (use a tunnel in dev).
PUBLIC_URL=http://localhost:4005

# Optional: instead of setting CALLE_API_KEY above, secrets can be read at
# runtime from AWS SSM Parameter Store, so nothing is written to disk. The
# parameter value is a whole .env body. Leave unset to skip SSM entirely.
# SSM_PROFILE=default
# SSM_REGION=eu-west-1
# SSM_PREFIX=/calle/secrets
