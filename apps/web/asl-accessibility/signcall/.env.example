# Copy this file to .env and fill it in. .env is git-ignored -- never commit it.
# Variables already set in your shell win over this file.

# --- Credentials -------------------------------------------------------------
# CALL-E API key. Only needed for real calls (CALLE_MOCK_MODE=0).
CALLE_API_KEY=
# Apify token for the Google Maps clinic search. Without it no clinic can be
# found: there is no fallback dataset, so the run ends with "no clinic found".
APIFY_API_TOKEN=

# --- Call mode ---------------------------------------------------------------
# 1 = every call is scripted: no real calls, no CALL-E credits spent.
# 0 = real calls.
CALLE_MOCK_MODE=1
# The server refuses to start with CALLE_MOCK_MODE=0 unless this is 1.
SIGNCALL_API_ALLOW_REAL_CALLS=0
# Scripted answers for mock mode; ignored when CALLE_MOCK_MODE=0.
SIGNCALL_API_DEMO_MOCKS=1
# Real mode only: comma-separated E.164 numbers you control. Every clinic and
# interpreter call is redirected to one of these instead of the real recipient.
# The server refuses to start in real mode without it.
# SIGNCALL_TEST_LINES=+15555550101,+15555550102

# --- Interpreter search ------------------------------------------------------
# Set to 1 to skip the live Illinois directory lookup (offline development).
# SIGNCALL_DISABLE_IL_LOOKUP=0
# Set to 1 to call each interpreter batch in parallel. Needs a CALL-E plan that
# allows concurrent outbound calls.
# SIGNCALL_FREELANCE_PARALLEL_BATCH=0

# --- Talking to the frontend -------------------------------------------------
# Where run events (approval requests, outcomes) are POSTed.
SIGNCALL_NOTIFY_URL=http://localhost:8000/notifications
# Seconds to wait for the user's approval before treating no answer as "no".
# SIGNCALL_CONFIRM_TIMEOUT_SECONDS=900
