# Copy this file to .env and fill it in. .env is git-ignored -- never commit it.
# Variables already set in your shell win over this file.

# Reads ID / insurance card photos and turns a signed or typed request into
# structured availability.
GEMINI_API_KEY=

# The booking workflow's POST /runs endpoint (the signcall server).
BOOKING_WORKFLOW_URL=http://localhost:8001/runs

# Shared secret for workflow notifications. Must be the same value as
# SIGNCALL_NOTIFY_SECRET in signcall/.env. Notifications without it are
# refused (the app then updates by polling). Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNCALL_NOTIFY_SECRET=

# Optional: pin the Gemini model (default: gemini-flash-latest).
# GEMINI_MODEL=
