{
  "name": "callops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repair follow-up simulation, synthetic evidence reader and disabled CALL-E integration source.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup:calle": "npm --prefix tools/calle-cli ci --ignore-scripts --no-audit --no-fund"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
