# CRC_CONSOLE_TOKEN is REQUIRED: the console serves call transcripts and spends
# the CALL-E API key, so the routes refuse to answer without it rather than
# defaulting open. Everything else is optional; with none of it the console runs
# on the fixtures and places no calls.
CRC_CONSOLE_TOKEN=        # send as X-CRC-Console (or Authorization: Bearer).
                          # Unset is fine for a local demo: the server generates one
                          # per run and prints it. It is never anonymous either way.
CALLE_API_KEY=            # read-only fetch of existing call tasks by id (never creates calls)
CALLE_BASE_URL=https://api.heycall-e.com   # must be https and an allow-listed host
CALLE_ALLOWED_HOSTS=      # comma separated; defaults to api.heycall-e.com
CRC_DATA_DIR=./data       # where ingested snapshots and review notes are written
CRC_USE_LLM=false         # model-assisted evidence check (needs GOOGLE_API_KEY or Vertex settings)
GOOGLE_API_KEY=
CRC_WEBHOOK_TOKEN=        # REQUIRED to receive webhooks: sent as X-CRC-Token.
                          # Unset means the receiver refuses every delivery rather than
                          # storing payloads from whoever finds the URL (deliveries are unsigned).
