# All optional. Without any of these the console runs on the fixtures and places no calls.
CALLE_API_KEY=            # read-only fetch of existing call tasks by id (never creates calls)
CALLE_BASE_URL=https://api.heycall-e.com
CRC_DATA_DIR=./data       # where ingested snapshots and review notes are written
CRC_USE_LLM=false         # model-assisted evidence check (needs GOOGLE_API_KEY or Vertex settings)
GOOGLE_API_KEY=
CRC_WEBHOOK_TOKEN=            # when set, POST /calle/webhook must send it as X-CRC-Token (CALL-E deliveries are unsigned)
