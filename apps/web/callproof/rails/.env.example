# Safe defaults: no real CALL-E call and no external LLM request.
CALLPROOF_CALL_PROVIDER=fake
CALLPROOF_ANALYZER_ADAPTER=fake
CALLPROOF_ANALYZER_URL=http://localhost:8001
CALLPROOF_ANALYZER_CALLBACK_URL=https://replace-with-your-tunnel.example/webhooks/call_analyzer
CALLPROOF_ANALYZER_WEBHOOK_SECRET=replace-me
AGENTKIT_LLM_ADAPTER=fake

# Required only for an explicit live integration run.
CALLPROOF_LIVE_CALLS=false
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_WEBHOOK_URL=https://replace-with-your-tunnel.example/calle/webhook
