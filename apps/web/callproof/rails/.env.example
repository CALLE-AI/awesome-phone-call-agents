# Copy to .env and fill in. The real .env is git-ignored and must never be committed.
# Safe defaults: no real CALL-E call and no external LLM request.
CALLPROOF_CALL_PROVIDER=fake
CALLPROOF_ANALYZER_ADAPTER=fake
CALLPROOF_ANALYZER_URL=http://localhost:8001
CALLPROOF_ANALYZER_CALLBACK_URL=https://replace-with-your-tunnel.example/webhooks/call_analyzer
CALLPROOF_ANALYZER_WEBHOOK_SECRET=replace-me
AGENTKIT_LLM_ADAPTER=fake

# Operator authentication — gates the entire live-call workflow (new/preview/confirm)
# and the call detail view. Leave the password blank to keep the live workflow fully
# locked (fail-closed): with no password set, no operator can reach the confirm action.
CALLPROOF_OPERATOR_USER=operator
CALLPROOF_OPERATOR_PASSWORD=

# Required only for an explicit live integration run.
CALLPROOF_LIVE_CALLS=false
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_WEBHOOK_URL=https://replace-with-your-tunnel.example/calle/webhook
# Optional: comma-separated HTTPS host allowlist that may receive the Bearer key.
# Defaults to the host of CALLE_BASE_URL when unset.
CALLE_ALLOWED_HOSTS=api.heycall-e.com
