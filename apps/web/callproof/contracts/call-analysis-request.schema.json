{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://callproof.dev/contracts/call-analysis-request.schema.json",
  "title": "CallProof call analysis request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "call_id",
    "submitted_at",
    "call_contract",
    "transcript",
    "callback"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "call_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "agentkit_run_id": { "type": ["string", "null"], "maxLength": 255 },
    "submitted_at": { "type": "string", "format": "date-time" },
    "call_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "success_conditions", "allowed_commitments", "escalation_conditions"],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "success_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "allowed_commitments": { "type": "object" },
        "forbidden_commitments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "required_disclosures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "escalation_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "turns"],
      "properties": {
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transcript_turn" }
        }
      }
    },
    "provider_result": { "type": ["object", "null"] },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "transcript_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speaker", "text"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "speaker": { "enum": ["agent", "recipient", "system", "unknown"] },
        "text": { "type": "string", "minLength": 1 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "ended_at_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
