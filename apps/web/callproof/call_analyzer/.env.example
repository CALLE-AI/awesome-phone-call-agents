CALL_ANALYZER_DATABASE_PATH=call_analyzer.db
# Anything other than development/test makes CALLPROOF_WEBHOOK_SECRET mandatory:
# the service refuses to start rather than sign with the public development default.
CALL_ANALYZER_ENV=development
CALL_ANALYZER_QUEUE_MODE=inline
CALL_ANALYZER_QUEUE_NAME=callproof
CALL_ANALYZER_DELIVER_WEBHOOKS=false
CALLPROOF_WEBHOOK_SECRET=replace-me
REDIS_URL=redis://localhost:6379/0

