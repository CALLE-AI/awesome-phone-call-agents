# FieldClose configuration contract.
# Copy this file to .env.local when configuring the application locally.
# Never commit populated credentials, encryption keys, phone numbers, or personal data.

# Application and PostgreSQL
# Production requires an HTTPS FIELDCLOSE_PUBLIC_BASE_URL (or BETTER_AUTH_URL)
# and an explicit DATABASE_URL. A non-loopback production URL must include
# sslmode=verify-full; sslmode=require is rejected because it skips certificate
# verification in postgres.js. The local fallbacks are development-only.
FIELDCLOSE_PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=

# Better Auth. Use at least 32 high-entropy characters for BETTER_AUTH_SECRET.
# Local development prints verification messages to the server console when no
# email provider is configured. For deployment, configure exactly one delivery
# option: the complete SMTP block or the complete Resend block.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP email delivery. Port 587 normally uses TLS=true and SSL=false so the
# connection upgrades through STARTTLS. Port 465 normally uses the reverse.
# Production requires SMTP_USE_TLS=true or SMTP_USE_SSL=true.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# Alternative Resend HTTPS delivery.
RESEND_API_KEY=
FIELDCLOSE_AUTH_EMAIL_FROM=

# Optional GitHub OAuth for developers and evaluators. Configure the callback:
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated, server-only allowlist of signed-in users who may configure
# their own protected CALL-E workspace. Empty means nobody is authorized.
FIELDCLOSE_PROTECTED_OPERATOR_EMAILS=

# The public demo must remain fake-only. Live calls require a separate protected
# deployment, this server-side flag, a database kill switch, and exact approval.
FIELDCLOSE_DEMO_MODE=true
FIELDCLOSE_LIVE_CALLS_ENABLED=false

# Separate base64-encoded 32-byte keys for field encryption and lookup HMAC.
FIELDCLOSE_DATA_KEY=
FIELDCLOSE_LOOKUP_KEY=
FIELDCLOSE_PHONE_KEY_VERSION=v1

# Leave these empty in local development, CI, and the public demo.
# Production uses an HTTPS CALL_E_BASE_URL; an HTTP base URL is rejected.
CALL_E_API_KEY=
CALL_E_BASE_URL=https://api.heycall-e.com
