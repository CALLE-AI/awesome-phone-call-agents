# Local Atlas — environment
#
# Nothing here is required to boot. With an empty file the map, the weather,
# the listings and every already-collected verified fact still work; features
# whose key is missing hide themselves rather than erroring.
#
# All sample phone numbers below use the reserved fictional 555-01xx range.
#
# The app has no dotenv dependency and does not read this file on its own.
# Copy it to .env and start with `node --env-file=.env server.js` (Node 20.6+),
# or export the variables yourself. See README.md.

# ---------------------------------------------------------------------------
# CALL-E — "Ask the Place"
# ---------------------------------------------------------------------------

# CALL-E credential. Absent => the feature reports itself unconfigured and the
# rest of the app is unaffected.
CALLE_API_KEY=

# CALLE_BASE_URL is deliberately absent, and is an allowlist rather than a URL
# field: the key is a bearer credential, so the host it is sent to is part of
# the secret's blast radius. Only https://api.heycall-e.com and the staging
# mirror https://test-api.heycall-e.com are accepted, matched exactly on origin.
# Any other value disables live calls instead of falling back to the default.

# 1 = the feature is configured without a CALL-E credential AND no call is
# placed. The entire flow still runs — validation, moderation, confirmation,
# storage, polling, the panel — with every result simulated and labelled.
# This is a hard switch, not a hint: it overrides a present CALLE_API_KEY and a
# correct access code, and it also blocks every credentialed request, because
# the one function that builds the API client refuses to run while it is set.
# This is the default posture for review and for demos.
CALLE_DRY_RUN=1

# 1 = run call requests as a fixed local reviewer, so the flow is reachable
# with no identity provider. Applies only when Supabase is unconfigured AND the
# server cannot dial (no CALLE_API_KEY, or CALLE_DRY_RUN=1), so it is inert on
# any real deployment.
REVIEW_MODE=1

# Unlocks real calls. UNSET => every call is simulated, no matter what else is
# configured. A wrong or missing code produces a clearly-labelled simulated
# answer; it never silently places a real call.
REAL_CALL_ACCESS_CODE=

# Makes the result callback URL unguessable. CALL-E webhook deliveries are not
# signed, so this is the only protection the path has. Any long random string.
CALLE_WEBHOOK_TOKEN=

# Hard ceiling on calls placed per day, reserved before dialling.
CALLE_DAILY_CALL_BUDGET=25

# How long a collected fact lives. A shared fact earns 90 days by being
# reusable; a private answer about one visit is spent when that visit happens.
CALLE_FAQ_TTL_DAYS=90
CALLE_PRIVATE_TTL_DAYS=30

# What the agent says it is calling on behalf of.
CALLE_CALLER_IDENTITY=Local Atlas, a local guide website

# Simulation controls. Pin an outcome for a scripted demo, or change how long
# a simulated call appears to take.
CALLE_SIM_OUTCOME=
CALLE_SIM_DURATION_MS=18000

# Public origin the webhook must be reachable on. On Render this is provided
# automatically as RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Demo listing — a line you own, so demos never trouble a real business
# ---------------------------------------------------------------------------
# DEMO_PLACE_PHONE is both the number and the on switch: without it there is no
# demo listing at all, so a fork cannot inherit anyone's phone number. The
# listing surfaces only near its own coordinates, in its own category, and is
# labelled a test listing wherever it appears.
DEMO_PLACE_PHONE=+12015550123
DEMO_PLACE_NAME=Example Inclusive Playground (test listing)
DEMO_PLACE_LAT=40.7128
DEMO_PLACE_LON=-74.0060
DEMO_PLACE_CATEGORY=kids
DEMO_PLACE_KIND=inclusive playground
DEMO_PLACE_ADDR=Example Park, Sample Township

# ---------------------------------------------------------------------------
# Accounts — required to REQUEST a call; not required to read collected facts
# ---------------------------------------------------------------------------
# Both values are public by design; the anon key ships to the browser. There is
# deliberately no service-role key in this app. Without these, browsing and
# reading verified facts work as normal and /api/ask-place returns 503
# auth_unconfigured.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Durable storage — verified facts, private results, budget counters
# ---------------------------------------------------------------------------
# Without Redis the app runs, but every restart forgets collected facts, which
# defeats the point of collecting them. Use the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Optional data providers — each one only enables its own feature
# ---------------------------------------------------------------------------
# GEMINI_API_KEY also powers question suggestions and the moderation check that
# custom questions must pass. Without it, custom free-text questions are
# refused (fail-closed) and the fixed question templates remain available.
GEMINI_API_KEY=
GOOGLE_API_KEY=
FSQ_API_KEY=
TICKETMASTER_API_KEY=
OPENWEATHER_API_KEY=
WINDY_API_KEY=
NASA_API_KEY=
NPS_API_KEY=
CENSUS_API_KEY=
